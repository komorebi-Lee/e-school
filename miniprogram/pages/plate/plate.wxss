.plate-hero { background: #002fa7; color: #fff; border-radius: 30rpx; padding: 34rpx; position: relative; overflow: hidden; }
.plate-hero::after { content: ""; position: absolute; width: 190rpx; height: 190rpx; border: 28rpx solid rgba(255,255,255,.1); border-radius: 50%; right: -80rpx; top: -80rpx; }
.plate-icon { display: inline-flex; background: #fff; color: #002fa7; border-radius: 10rpx; padding: 10rpx 18rpx; font-weight: 900; letter-spacing: 5rpx; }
.hero-label { color: #bcd0ff; font-size: 21rpx; margin-top: 28rpx; }.hero-title { font-size: 42rpx; font-weight: 900; margin: 10rpx 0 18rpx; }.hero-copy { color: #dce6ff; line-height: 1.7; font-size: 23rpx; width: 88%; }
.process { padding: 26rpx; margin-top: 22rpx; }.step { display: flex; align-items: center; }.step-no { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; border-radius: 50%; background: #eaf0ff; color: #002fa7; font-weight: 900; margin-right: 20rpx; }.step-title { font-weight: 800; margin-bottom: 5rpx; }.step-line { width: 4rpx; height: 34rpx; background: #dce6ff; margin: 7rpx 0 7rpx 24rpx; }
.status { padding: 26rpx; margin-top: 22rpx; border-left: 8rpx solid #002fa7; }.status-label { color: #78849a; font-size: 21rpx; }.status-value { font-size: 31rpx; font-weight: 900; margin: 8rpx 0; }
.source-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.source-card { padding: 24rpx; border: 3rpx solid transparent; position: relative; }.source-card.selected { border-color: #002fa7; background: #f7f9ff; }.source-badge { display: inline-flex; padding: 7rpx 13rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 900; }.source-badge.free { background: #d9f7ea; color: #157552; }.source-badge.paid { background: #eaf0ff; color: #002fa7; }.source-title { font-size: 28rpx; font-weight: 900; margin: 18rpx 0 10rpx; }.source-copy { color: #78849a; font-size: 21rpx; line-height: 1.55; }.empty-order { background: #fff7cf; color: #6f5a00; padding: 18rpx; border-radius: 14rpx; font-size: 22rpx; line-height: 1.6; }
.form { padding: 28rpx; }.notice { color: #6f5a00; background: #fff7cf; padding: 22rpx; border-radius: 18rpx; line-height: 1.7; font-size: 22rpx; margin-top: 24rpx; }.service-button { margin-top: 22rpx; }
