<view class="page store-page">
  <!-- 失败占位：接口挂了必须说出来，并且能重试。旧数据（若有）仍显示在下方。 -->
  <view wx:if="{{storefrontError}}" class="load-error card">
    <view class="muted">{{storefrontError}}</view>
    <button size="mini" class="ghost-button" bindtap="retryStorefront">重试</button>
  </view>
  <view wx:if="{{loading}}" class="empty card"><view class="muted">正在加载店铺信息</view></view>
  <!-- ★ 只有**确定是 404** 才落这句。网络失败时 `storeNotFound` 为假，走上面的错误占位 ——
       改造前这里判的是 `!store`，于是任何失败都会对一家真实在营的商家断言「不存在或未通过核准」。 -->
  <view wx:elif="{{storeNotFound}}" class="empty card"><view class="muted">店铺不存在或未通过平台核准</view></view>
  <block wx:if="{{store}}">
    <view class="storefront card">
      <view class="storefront-head">
        <view class="storefront-brand">{{store.name}}</view>
        <view class="storefront-score {{store.scoreToneClass}}">
          <text class="score-value">{{store.scoreText}}</text>
          <text class="muted small">{{store.gradeText}}</text>
        </view>
      </view>
      <view class="muted storefront-desc">{{store.description}}</view>
      <view class="store-chips">
        <view class="chip">{{store.serviceArea}}</view>
        <view class="chip">{{store.responseText}}</view>
        <view class="chip">{{store.scoreNote}}</view>
      </view>
      <view class="store-stats">{{store.statsText}}</view>
      <view class="store-review-summary">
        <text>{{store.reviewText}}</text>
        <text class="strong">{{store.positiveRateText}}</text>
      </view>
    </view>

    <view class="section-head">
      <view class="section-title">在售商品</view>
      <view class="muted small">{{filteredProducts.length}} 件</view>
    </view>
    <view class="catalog card">
      <input class="catalog-search" placeholder="搜索店内商品" value="{{query}}" bindinput="setSearch" />
      <scroll-view class="catalog-tabs" scroll-x show-scrollbar="{{false}}">
        <view class="tab-inner">
          <view wx:for="{{categories}}" wx:key="key" class="catalog-tab {{activeCategory === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="setCategory">{{item.categoryText || item.text}}</view>
        </view>
      </scroll-view>
      <view class="sort-inner">
        <view wx:for="{{sortOptions}}" wx:key="key" class="sort-tab {{sortKey === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="setSort">{{item.text}}</view>
      </view>
    </view>
    <view class="products">
      <view class="product card" wx:for="{{filteredProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="goProduct">
        <view class="visual" style="background: {{item.color}}" data-url="{{item.imageUrl}}" catchtap="previewProductImage">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
          <text wx:else>{{item.icon}}</text>
        </view>
        <view class="product-info">
          <view class="product-name">{{item.name}}</view>
          <view class="muted product-desc">{{item.description}}</view>
          <view class="product-meta">
            <text>{{item.stockText}}</text>
            <text>{{item.salesText}}</text>
            <text>{{item.ratingText}}</text>
          </view>
          <view class="price-line">
            <text class="price">¥{{item.price}}</text>
            <text wx:if="{{item.originalPrice}}" class="original">¥{{item.originalPrice}}</text>
            <text wx:if="{{item.promoText}}" class="promo">{{item.promoText}}</text>
          </view>
        </view>
      </view>
    </view>
    <!-- ★ 渲染点 2：失败时不得落「这家店暂无在售商品」——那是关于这家店在售状态的事实陈述。 -->
    <view wx:if="{{!filteredProducts.length && !storefrontError}}" class="empty card"><view class="muted">{{products.length ? '没有符合筛选的商品' : '这家店暂无在售商品'}}</view></view>

    <view class="section-title">同学评价</view>
    <view class="store-reviews">
      <view class="store-review card" wx:for="{{reviews}}" wx:key="id">
        <view class="review-head">
          <text class="review-stars">{{item.stars}}</text>
          <text class="review-product">{{item.productName}}</text>
          <text class="muted small">{{item.timeText}}</text>
        </view>
        <view class="review-content">{{item.content}}</view>
        <view class="review-images" wx:if="{{item.images.length}}">
          <image wx:for="{{item.images}}" wx:for-item="image" wx:key="*this" class="review-image" src="{{image}}" mode="aspectFill" data-urls="{{item.images}}" data-url="{{image}}" bindtap="previewReviewImages" />
        </view>
        <view class="muted small review-person">{{item.customerName}} · {{item.college || '华中农业大学'}}</view>
        <view class="merchant-reply" wx:if="{{item.reply}}">
          <view class="reply-head"><text class="reply-name">{{item.reply.merchantName}}</text></view>
          <view class="reply-content">{{item.reply.content}}</view>
        </view>
      </view>
    </view>
    <!-- ★ 渲染点 3：同理，失败时不得落「这家店暂无已购评价」。 -->
    <view wx:if="{{!reviews.length && !storefrontError}}" class="empty card"><view class="muted">这家店暂无已购评价</view></view>
  </block>
</view>
