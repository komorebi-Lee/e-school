.detail-page { padding-top: 0; }.visual { height: 390rpx; border-radius: 0 0 38rpx 38rpx; display: flex; align-items: center; justify-content: center; font-size: 120rpx; color: #1746a2; font-weight: 900; position: relative; }.badge { position: absolute; top: 28rpx; left: 28rpx; background: rgba(255,255,255,.8); }.main { margin-top: -34rpx; position: relative; padding: 30rpx; }.name { font-size: 40rpx; font-weight: 900; }.price-line { margin-top: 20rpx; }.price-line .price { font-size: 42rpx; }.original { color: #a2aabc; text-decoration: line-through; margin-left: 14rpx; }.spec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 20rpx; }.spec { padding: 22rpx; display: flex; flex-direction: column; }.spec-value { font-size: 31rpx; font-weight: 900; margin-bottom: 4rpx; }.policy,.services { padding: 24rpx; }.policy { color: #157552; background: #eafaf3; }.service-item { padding: 14rpx 0; border-bottom: 1rpx solid #edf0f5; }.service-item:last-child { border: 0; }.check { color: #24b47e; font-weight: 900; margin-right: 16rpx; }.safe-space { height: 150rpx; }.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 20rpx 28rpx 30rpx; box-shadow: 0 -10rpx 30rpx rgba(23,32,51,.08); display: flex; justify-content: space-between; align-items: center; }.small { font-size: 20rpx; }.buy { width: 300rpx; margin: 0; }
