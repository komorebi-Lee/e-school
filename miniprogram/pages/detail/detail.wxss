.detail-page { padding-top: 0; }.visual { height: 390rpx; border-radius: 0 0 38rpx 38rpx; display: flex; align-items: center; justify-content: center; font-size: 120rpx; color: #1746a2; font-weight: 900; position: relative; }.product-image { width: 100%; height: 100%; }.badge { position: absolute; top: 28rpx; left: 28rpx; background: rgba(255,255,255,.8); }.main { margin-top: -34rpx; position: relative; padding: 30rpx; }.name { font-size: 40rpx; font-weight: 900; }.price-line { margin-top: 20rpx; }.price-line .price { font-size: 42rpx; }.original { color: #a2aabc; text-decoration: line-through; margin-left: 14rpx; }.seller-line { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0f5; }.seller { color: #002fa7; font-size: 23rpx; font-weight: 800; }.trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-top: 20rpx; }.trust-item { display: flex; align-items: center; gap: 10rpx; padding: 18rpx; color: #33435f; font-size: 21rpx; font-weight: 700; }.trust-mark { display: inline-flex; width: 34rpx; height: 34rpx; align-items: center; justify-content: center; border-radius: 10rpx; background: #eaf0ff; color: #002fa7; font-size: 18rpx; }.spec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 20rpx; }.spec { padding: 22rpx; display: flex; flex-direction: column; }.spec-value { font-size: 31rpx; font-weight: 900; margin-bottom: 4rpx; }.policy,.services { padding: 24rpx; }.policy { color: #157552; background: #eafaf3; }.service-item { padding: 14rpx 0; border-bottom: 1rpx solid #edf0f5; }.service-item:last-child { border: 0; }.check { color: #24b47e; font-weight: 900; margin-right: 16rpx; }.reviews { padding: 24rpx; }.review-summary { display: flex; gap: 20rpx; align-items: center; padding-bottom: 20rpx; border-bottom: 1rpx solid #edf0f5; }.review-score { color: #002fa7; font-size: 46rpx; font-weight: 900; }.review-count { font-size: 24rpx; font-weight: 850; color: #202b45; }.review-item { padding: 22rpx 0; border-bottom: 1rpx solid #edf0f5; }.review-item:last-child { border-bottom: 0; }.review-head { display: flex; gap: 14rpx; align-items: center; }.review-avatar { width: 52rpx; height: 52rpx; display: inline-flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #eaf0ff; color: #002fa7; font-size: 22rpx; font-weight: 900; }.review-person { flex: 1; min-width: 0; }.review-name { font-size: 24rpx; font-weight: 800; color: #202b45; }.review-meta-text { margin-top: 4rpx; font-size: 19rpx; line-height: 1.35; }.review-stars { color: #ff9f1a; font-size: 22rpx; font-weight: 900; }.review-content { margin-top: 14rpx; color: #33435f; font-size: 23rpx; line-height: 1.55; }.review-empty { padding: 18rpx 0 4rpx; font-size: 22rpx; line-height: 1.45; }.empty { padding: 50rpx 30rpx; text-align: center; }.safe-space { height: 150rpx; }.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 20rpx 28rpx 30rpx; box-shadow: 0 -10rpx 30rpx rgba(23,32,51,.08); display: flex; justify-content: space-between; align-items: center; }.small { font-size: 20rpx; }.buy { width: 300rpx; margin: 0; }
.review-images { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 16rpx; }
.review-image { width: 100%; aspect-ratio: 4 / 3; border-radius: 14rpx; background: #f2f5fa; }
.merchant-reply { margin-top: 16rpx; padding: 16rpx; background: #f7f9ff; border-radius: 16rpx; }
.reply-head { display: flex; justify-content: space-between; align-items: center; }
.reply-name { color: #002fa7; font-size: 21rpx; font-weight: 850; }
.reply-time { font-size: 19rpx; }
.reply-content { margin-top: 8rpx; color: #33435f; font-size: 21rpx; line-height: 1.5; }
.related-rail { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; padding: 18rpx; }
.related-item { min-width: 0; }
.related-visual { height: 140rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; overflow: hidden; color: #1746a2; font-weight: 900; }
.related-image { width: 100%; height: 100%; }
.related-name { margin-top: 12rpx; color: #17233d; font-size: 23rpx; font-weight: 850; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }
.related-copy { margin-top: 5rpx; font-size: 19rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.related-price { margin-top: 8rpx; color: #002fa7; font-size: 25rpx; font-weight: 900; }
.related-score { margin-left: 8rpx; font-size: 19rpx; font-weight: 650; }
.questions { padding: 22rpx; }
.question-item { padding: 16rpx 0; border-bottom: 1rpx solid #edf0f5; }
.question-item:last-child { border-bottom: 0; }
.question { color: #17233d; font-size: 24rpx; font-weight: 850; }
.answer { margin-top: 7rpx; color: #536078; font-size: 21rpx; line-height: 1.5; }

.shop-score { margin-top: 20rpx; }
.shop-score-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.shop-score-title { font-size: 26rpx; font-weight: 800; color: #1f2733; }
.shop-score-value { display: flex; flex-direction: column; align-items: flex-end; }
.shop-score-number { font-size: 40rpx; font-weight: 900; line-height: 1; }
.shop-score-grade { font-size: 20rpx; font-weight: 700; margin-top: 4rpx; }
.shop-score-value.tone-good { color: #1f8f4e; }
.shop-score-value.tone-watch { color: #d98219; }
.shop-score-value.tone-risk { color: #c0392b; }
.shop-score-note { margin-top: 10rpx; line-height: 1.5; }
