<view class="page detail-page">
  <view wx:if="{{loading}}" class="empty card"><view class="muted">正在加载车型…</view></view>
  <!-- 失败占位：接口挂了必须说出来，并且能重试。旧数据（若有）仍显示在下方。 -->
  <view wx:if="{{loadError}}" class="load-error card">
    <view class="muted">{{loadError}}</view>
    <button size="mini" class="ghost-button" bindtap="retryProduct">重试</button>
  </view>
  <!-- ★ 只有**确定是 404**（`goneText` 被换成「该商品已下架」）或缓存里确实没有时才落这句。
       改造前网络失败也会走到这里，把一次抖动说成「车型不存在或已下架」。
       ★ `!loading` 是 T49 收尾时补上的 —— 同一条假陈述的**第三种触发时机**
       （前两种：① `catch` 落空态；② 改造前失败时把数据清空），第三种是
       **首屏那一次请求还没回来**：此时失败标志初值为空、数据也为空，空态条件成立。
       这一支挂在
       **另一条链**上（链头是第 4 行的 `wx:if="{{loadError}}"`），所以第 2 行的
       `wx:if="{{loading}}"` **挡不住它** —— 首屏那一次请求还没回来时
       `scooter === null && loadError === ''`，页面会**同时**渲染
       「正在加载车型…」和「车型不存在或已下架」。`!loading` 把这一段挡住。 -->
  <view wx:elif="{{!loading && !scooter && !loadError}}" class="empty card"><view class="muted">{{goneText}}</view></view>
  <block wx:if="{{scooter}}">
  <view class="visual" style="background: {{scooter.color}}"><view class="pill badge">{{scooter.badge}}</view><image wx:if="{{scooter.imageUrl}}" class="product-image" src="{{scooter.imageUrl}}" mode="aspectFit" data-url="{{scooter.imageUrl}}" bindtap="previewProductImage" /><text wx:else>{{scooter.icon}}</text></view>
  <view class="main card"><view class="name">{{scooter.name}}</view><view class="muted">{{scooter.subtitle}}</view><view class="price-line"><text wx:if="{{scooter.isRental}}" class="price">{{scooter.priceText}}</text><text wx:else class="price">¥{{scooter.promotionPrice || scooter.price}}</text><text wx:if="{{scooter.originalPriceText}}" class="original">{{scooter.originalPriceText}}</text><text wx:if="{{scooter.originalPrice}}" class="original">¥{{scooter.originalPrice}}</text><text wx:if="{{scooter.promotionStatusText}}" class="promo">{{scooter.promotionStatusText}}</text></view><view class="rental-line" wx:if="{{scooter.isRental}}"><text class="rental-tag">可租赁</text><text class="muted">{{scooter.depositText}} · {{scooter.rentalRangeText}}</text></view><view class="seller-line"><text class="seller">{{scooter.merchantName}}</text><text wx:if="{{scooter.merchantRectify}}" class="rectify-badge tone-{{scooter.merchantRectify.toneClass}}">{{scooter.merchantRectify.badgeText}}</text><text class="muted">{{scooter.stockText}}</text></view><view class="muted small" wx:if="{{scooter.stockHint}}">{{scooter.stockHint}}</view></view>
  <view class="rectify-banner tone-{{scooter.merchantRectify.toneClass}}" wx:if="{{scooter.merchantRectify}}">
    <view class="rectify-title">{{scooter.merchantRectify.title}}</view>
    <view class="muted small">{{scooter.merchantRectify.detail}}</view>
  </view>
  <view class="storefront card" wx:if="{{scooter.storeProfile}}" bindtap="goStore">
    <view class="storefront-head">
      <view class="storefront-name">{{scooter.storeProfile.name}}<text class="store-entry">进店</text></view>
      <view class="storefront-score {{scooter.storeProfile.scoreToneClass}}">
        <view class="storefront-score-value">{{scooter.storeProfile.scoreText}}</view>
        <view class="muted small">{{scooter.storeProfile.scoreLabel}}</view>
      </view>
    </view>
    <view class="storefront-stats">
      <view><view class="storefront-stat-value">{{scooter.storeProfile.soldCount}}</view><view class="muted small">销量</view></view>
      <view><view class="storefront-stat-value">{{scooter.storeProfile.ratingText}}</view><view class="muted small">评分</view></view>
      <view><view class="storefront-stat-value">{{scooter.storeProfile.scoreText}}</view><view class="muted small">服务分</view></view>
    </view>
    <view class="muted small storefront-foot">{{scooter.storeProfile.responseText}} · {{scooter.storeProfile.positiveText}}</view>
  </view>
  <view class="trust-grid"><view class="trust-item card"><text class="trust-mark">配</text><text>校内配送</text></view><view class="trust-item card"><text class="trust-mark">牌</text><text>牌照辅助</text></view><view class="trust-item card"><text class="trust-mark">付</text><text>在线支付</text></view></view>
  <view class="promise-grid" wx:if="{{scooter.servicePromises.length}}">
    <view class="promise card" wx:for="{{scooter.servicePromises}}" wx:key="title">
      <view class="promise-title">{{item.title}}</view>
      <view class="muted small">{{item.detail}}</view>
    </view>
  </view>
  <view class="shop-score card" wx:if="{{scooter.merchantScoreCard}}">
    <view class="shop-score-head">
      <view>
        <view class="shop-score-title">{{scooter.merchantName}} · 店铺服务分</view>
        <view class="muted small">{{scooter.merchantScoreCard.onTimeText}} · {{scooter.merchantScoreCard.reviewText}}</view>
      </view>
      <view class="shop-score-value tone-{{scooter.merchantScoreCard.toneClass}}">
        <text class="shop-score-number">{{scooter.merchantScoreCard.score}}</text>
        <text class="shop-score-grade">{{scooter.merchantScoreCard.gradeLabel}}</text>
      </view>
    </view>
    <view class="muted small shop-score-note">{{scooter.merchantScoreCard.noteText}}</view>
  </view>
  <view class="spec-grid"><view class="spec card" wx:if="{{scooter.range}}"><text class="spec-value">{{scooter.range}}</text><text class="muted">参考续航</text></view><view class="spec card"><text class="spec-value">{{scooter.speed}}</text><text class="muted">最高速度</text></view></view>
  <block wx:if="{{scooter.isRental}}">
  <view class="section-title">租赁方案</view>
  <view class="rental-plan card">
    <view class="rental-plan-row"><text class="rental-plan-label">计费单位</text><text class="rental-plan-value">按{{scooter.rentalUnitLabel}}计费</text></view>
    <view class="rental-plan-row"><text class="rental-plan-label">租金</text><text class="rental-plan-value">{{scooter.priceText}}</text></view>
    <view class="rental-plan-row"><text class="rental-plan-label">押金</text><text class="rental-plan-value">{{scooter.depositText}}</text></view>
    <view class="rental-plan-row"><text class="rental-plan-label">租期</text><text class="rental-plan-value">{{scooter.rentalRangeText}}</text></view>
    <view class="muted small rental-plan-note">归还验收通过后结算押金，逾期与损坏按平台规则处理。</view>
  </view>
  </block>
  <view class="section-title">校区适配</view><view class="policy card"><text class="check">✓</text>{{scooter.policy}}</view>
  <view class="section-title">服务包含</view><view class="card services"><view wx:for="{{scooter.service}}" wx:key="*this" class="service-item"><text class="check">✓</text>{{item}}</view></view>

  <view class="section-title">校园同学评价</view>
  <view class="reviews card">
    <view class="review-summary">
      <view class="review-score">{{scooter.review.scoreText}}</view>
      <view class="review-meta"><view class="review-count">{{scooter.review.countText}}</view><view class="muted">{{scooter.review.trustText}}</view></view>
    </view>
    <view class="review-tabs" wx:if="{{scooter.reviewFilters.length}}">
      <view class="review-tab {{reviewFilter === item.key ? 'active' : ''}}" wx:for="{{scooter.reviewFilters}}" wx:key="key" data-key="{{item.key}}" bindtap="setReviewFilter">{{item.label}} {{item.count}}</view>
    </view>
    <view class="review-item" wx:for="{{scooter.reviews}}" wx:key="id">
      <view class="review-head">
        <text class="review-avatar">{{item.initial}}</text>
        <view class="review-person"><view class="review-name">{{item.name}}</view><view class="muted review-meta-text">{{item.metaText}}</view></view>
        <text class="review-stars">{{item.stars}}</text>
      </view>
      <view class="review-content">{{item.content}}</view>
      <view class="review-images" wx:if="{{item.images.length}}"><image wx:for="{{item.images}}" wx:for-item="image" wx:key="*this" class="review-image" src="{{image}}" mode="aspectFill" data-urls="{{item.images}}" data-url="{{image}}" bindtap="previewReviewImages" /></view>
      <view class="merchant-reply" wx:if="{{item.reply}}"><view class="reply-head"><text class="reply-name">{{item.reply.merchantName}}</text><text class="muted reply-time">{{item.reply.timeText}}</text></view><view class="reply-content">{{item.reply.content}}</view></view>
    </view>
    <!-- ★ 这段「暂无评价」在 `<block wx:if="{{scooter}}">` **外面**（那个 block 第 63 行就关了），
         所以接口失败时它照样会被求值：`scooter` 为 null → `!scooter.reviews.length` 为真 →
         页面一边说「加载失败，请重试」一边说「这款车型暂无已购评价」。两个条件缺一不可：
         `scooter` 挡住「已下架 / 加载失败」两种情况，`!loadError` 挡住「有缓存但刷新失败」。 -->
    <view wx:if="{{scooter && !loadError && !scooter.reviews.length}}" class="muted review-empty">{{scooter.review.count ? '这个筛选下暂无评价' : '这款车型暂无已购评价，可先查看平台保障和服务承诺。'}}</view>
  </view>

  <view class="section-title">同类车型</view>
  <view class="related-rail card" wx:if="{{scooter.relatedProducts.length}}">
    <view class="related-item" wx:for="{{scooter.relatedProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="goRelated">
      <view class="related-visual" style="background: {{item.color}}"><image wx:if="{{item.imageUrl}}" class="related-image" src="{{item.imageUrl}}" mode="aspectFit" /><text wx:else>{{item.icon}}</text></view>
      <view class="related-name">{{item.name}}</view>
      <view class="muted related-copy">{{item.merchantName}} · {{item.stockText}}</view>
      <view class="related-price">¥{{item.price}}<text class="muted related-score">{{item.ratingText}}</text></view>
    </view>
  </view>

  <view class="section-title">买前常问</view>
  <view class="questions card"><view class="question-item" wx:for="{{scooter.questions}}" wx:key="id"><view class="question">{{item.question}}</view><view class="answer">{{item.answer}}</view></view></view>

<view class="safe-space"></view><view class="bottom-bar"><view><view class="muted small">{{scooter.headlineText}}</view><view class="price">{{scooter.priceText}}</view><view class="muted small" wx:if="{{scooter.isRental}}">{{scooter.depositText}} · {{scooter.rentalRangeText}}</view></view><view class="bottom-actions"><button class="favorite-button {{favorited ? 'active' : ''}}" bindtap="toggleFavorite">{{favorited ? '★ 已收藏' : '☆ 收藏'}}</button><button class="consult-button" bindtap="consult">咨询</button><button wx:if="{{!scooter.sellableStock}}" class="restock-button" bindtap="toggleRestockAlert">{{restockSubscribed ? '已登记到货提醒' : '到货提醒我'}}</button><button class="primary-button buy" disabled="{{!scooter.sellableStock}}" bindtap="checkout">{{scooter.actionText}}</button></view></view>
  </block>
</view>
