<view class="page detail-page">
  <view wx:if="{{loading}}" class="empty card"><view class="muted">正在加载车型…</view></view>
  <view wx:elif="{{!scooter}}" class="empty card"><view class="muted">车型不存在或已下架</view></view>
  <block wx:else>
  <view class="visual" style="background: {{scooter.color}}"><view class="pill badge">{{scooter.badge}}</view><image wx:if="{{scooter.imageUrl}}" class="product-image" src="{{scooter.imageUrl}}" mode="aspectFit" /><text wx:else>{{scooter.icon}}</text></view>
  <view class="main card"><view class="name">{{scooter.name}}</view><view class="muted">{{scooter.subtitle}}</view><view class="price-line"><text class="price">¥{{scooter.price}}</text><text wx:if="{{scooter.originalPrice}}" class="original">¥{{scooter.originalPrice}}</text></view><view class="seller-line"><text class="seller">{{scooter.merchantName}}</text><text class="muted">{{scooter.stockText}}</text></view><view class="muted small" wx:if="{{scooter.stockHint}}">{{scooter.stockHint}}</view></view>
  <view class="trust-grid"><view class="trust-item card"><text class="trust-mark">配</text><text>校内配送</text></view><view class="trust-item card"><text class="trust-mark">牌</text><text>牌照辅助</text></view><view class="trust-item card"><text class="trust-mark">付</text><text>在线支付</text></view></view>
  <view class="spec-grid"><view class="spec card"><text class="spec-value">{{scooter.range}}</text><text class="muted">参考续航</text></view><view class="spec card"><text class="spec-value">{{scooter.speed}}</text><text class="muted">最高速度</text></view></view>
  <view class="section-title">校区适配</view><view class="policy card"><text class="check">✓</text>{{scooter.policy}}</view>
  <view class="section-title">服务包含</view><view class="card services"><view wx:for="{{scooter.service}}" wx:key="*this" class="service-item"><text class="check">✓</text>{{item}}</view></view>

  <view class="section-title">校园同学评价</view>
  <view class="reviews card">
    <view class="review-summary">
      <view class="review-score">{{scooter.review.scoreText}}</view>
      <view class="review-meta"><view class="review-count">{{scooter.review.countText}}</view><view class="muted">{{scooter.review.trustText}}</view></view>
    </view>
    <view class="review-item" wx:for="{{scooter.reviews}}" wx:key="id">
      <view class="review-head">
        <text class="review-avatar">{{item.initial}}</text>
        <view class="review-person"><view class="review-name">{{item.name}}</view><view class="muted review-meta-text">{{item.metaText}}</view></view>
        <text class="review-stars">{{item.stars}}</text>
      </view>
      <view class="review-content">{{item.content}}</view>
      <view class="review-images" wx:if="{{item.images.length}}"><image wx:for="{{item.images}}" wx:for-item="image" wx:key="*this" class="review-image" src="{{image}}" mode="aspectFill" /></view>
      <view class="merchant-reply" wx:if="{{item.reply}}"><view class="reply-head"><text class="reply-name">{{item.reply.merchantName}}</text><text class="muted reply-time">{{item.reply.timeText}}</text></view><view class="reply-content">{{item.reply.content}}</view></view>
    </view>
    <view wx:if="{{!scooter.reviews.length}}" class="muted review-empty">这款车型暂无已购评价，可先查看平台保障和服务承诺。</view>
  </view>

  <view class="section-title">同类车型</view>
  <view class="related-rail card" wx:if="{{scooter.relatedProducts.length}}">
    <view class="related-item" wx:for="{{scooter.relatedProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="goRelated">
      <view class="related-visual" style="background: {{item.color}}"><image wx:if="{{item.imageUrl}}" class="related-image" src="{{item.imageUrl}}" mode="aspectFit" /><text wx:else>{{item.icon}}</text></view>
      <view class="related-name">{{item.name}}</view>
      <view class="muted related-copy">{{item.merchantName}} · {{item.stockText}}</view>
      <view class="related-price">¥{{item.price}}<text class="muted related-score">{{item.ratingText}}</text></view>
    </view>
  </view>

  <view class="section-title">买前常问</view>
  <view class="questions card"><view class="question-item" wx:for="{{scooter.questions}}" wx:key="id"><view class="question">{{item.question}}</view><view class="answer">{{item.answer}}</view></view></view>

  <view class="safe-space"></view><view class="bottom-bar"><view><view class="muted small">校内配送 · 可协助上牌</view><view class="price">¥{{scooter.price}}</view></view><button class="primary-button buy" disabled="{{!scooter.sellableStock}}" bindtap="checkout">{{scooter.sellableStock > 0 ? '立即购买' : '暂无可售'}}</button></view>
  </block>
</view>
