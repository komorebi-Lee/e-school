.profile { display: flex; align-items: center; padding: 28rpx; position: relative; }.avatar { width: 96rpx; height: 96rpx; line-height: 96rpx; text-align: center; border-radius: 28rpx; background: #002fa7; color: #fff; font-size: 42rpx; font-weight: 900; margin-right: 22rpx; }.name { font-size: 34rpx; font-weight: 900; margin-bottom: 8rpx; }.verify { position: absolute; right: 24rpx; top: 24rpx; background: #fff1b8; color: #8b6e00; }.verify.done { background: #d9f7ea; color: #157552; }.verify-card { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; background: #fff7cf; padding: 24rpx; border-radius: 24rpx; }.verify-title { font-weight: 800; margin-bottom: 6rpx; }.verify-card button { margin: 0; }.menu { padding: 0 26rpx; }.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid #edf0f5; }.menu-item:last-child { border: 0; }.arrow { color: #a2aabc; font-size: 38rpx; }.menu-note { color: #002fa7; font-size: 22rpx; }.version { text-align: center; color: #a2aabc; font-size: 21rpx; margin-top: 40rpx; }
