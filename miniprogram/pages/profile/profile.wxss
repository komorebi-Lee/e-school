.profile { display: flex; align-items: center; padding: 28rpx; position: relative; }.avatar { width: 96rpx; height: 96rpx; line-height: 96rpx; text-align: center; border-radius: 28rpx; background: #002fa7; color: #fff; font-size: 42rpx; font-weight: 900; margin-right: 22rpx; }.name { font-size: 34rpx; font-weight: 900; margin-bottom: 8rpx; }.verify { position: absolute; right: 24rpx; top: 24rpx; background: #fff1b8; color: #8b6e00; }.verify.done { background: #d9f7ea; color: #157552; }.verify-card { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; background: #fff7cf; padding: 24rpx; border-radius: 24rpx; }.verify-title { font-weight: 800; margin-bottom: 6rpx; }.verify-card button { margin: 0; }.menu { padding: 0 26rpx; }.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid #edf0f5; }.menu-item:last-child { border: 0; }.arrow { color: #a2aabc; font-size: 38rpx; }.menu-note { color: #002fa7; font-size: 22rpx; }.version { text-align: center; color: #a2aabc; font-size: 21rpx; margin-top: 40rpx; }
.menu-badge { width: 14rpx; height: 14rpx; margin-right: 12rpx; border-radius: 50%; background: #ff4d4f; }
.login-card { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 28rpx; margin-bottom: 20rpx; }
.login-title { font-size: 30rpx; font-weight: 900; }
.login-note { font-size: 21rpx; margin-top: 6rpx; max-width: 420rpx; }
.login-card button { margin: 0; }
.notification-card { margin-bottom: 20rpx; padding: 24rpx 28rpx; }
.notification-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 18rpx; }
.notification-title { font-size: 30rpx; font-weight: 900; }
.notification-card .muted { font-size: 22rpx; margin-top: 6rpx; }
.notification-item { display: flex; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid #edf0f5; }
.notification-item:last-child { border-bottom: 0; }
.notification-item.unread { border-left: 6rpx solid #002fa7; padding-left: 18rpx; }
.notification-main { display: flex; flex-direction: column; gap: 6rpx; color: #1b2537; }
.notification-main strong { font-size: 26rpx; }
.notification-main text { font-size: 22rpx; color: #536078; line-height: 1.5; }
.notification-time { color: #8895a8; font-size: 21rpx; white-space: nowrap; }
.notification-empty { padding: 24rpx 0 8rpx; color: #8895a8; font-size: 24rpx; }
.message-toggle { height: 68rpx; line-height: 66rpx; margin: 18rpx 0 0; border-radius: 999rpx; background: #eaf0ff; color: #002fa7; font-size: 23rpx; font-weight: 800; }
.message-toggle::after { border: 0; }
