.doc-head { padding: 30rpx; background: linear-gradient(135deg, #002fa7 0%, #204fd4 100%); color: #fff; }
.doc-label { font-size: 21rpx; color: #d7e2ff; font-weight: 800; }
.doc-title { font-size: 42rpx; font-weight: 900; margin: 10rpx 0 14rpx; }
.doc-head .muted { color: #d7e2ff; }
.doc-section { margin-top: 18rpx; padding: 26rpx; }
.section-heading { font-size: 30rpx; font-weight: 900; color: #17233d; margin-bottom: 18rpx; }
.doc-item { display: flex; gap: 14rpx; margin-bottom: 16rpx; }
.doc-item:last-child { margin-bottom: 0; }
.dot { width: 10rpx; height: 10rpx; margin-top: 14rpx; border-radius: 50%; background: #002fa7; flex: 0 0 auto; }
.doc-text { color: #33435f; font-size: 23rpx; line-height: 1.6; }
.contact-card { margin-top: 18rpx; padding: 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.contact-title { font-size: 26rpx; font-weight: 850; color: #17233d; }
.contact-card .ghost-button { margin: 0; min-width: 180rpx; }
.doc-foot { margin-top: 24rpx; text-align: center; font-size: 20rpx; line-height: 1.5; }
