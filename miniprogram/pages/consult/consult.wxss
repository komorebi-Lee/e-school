.hero{padding:34rpx 30rpx;margin-bottom:20rpx}.eyebrow{color:#002FA7;font-size:23rpx}.title{font-size:42rpx;font-weight:700;margin:10rpx 0;line-height:1.25}.context{display:flex;flex-direction:column;background:#eef3ff;color:#173d95;padding:18rpx 20rpx;border-radius:12rpx;margin:16rpx 0;box-sizing:border-box;max-width:100%;overflow:hidden}.context-label{font-size:22rpx;color:#6d7fa8;margin-bottom:6rpx}.context text:last-child{display:block;white-space:normal;word-break:break-all;line-height:1.45}.field{margin-bottom:20rpx}.field-label{display:block;margin-bottom:9rpx;color:#38445a;font-size:27rpx}.input{background:#f5f7fb;padding:18rpx;border-radius:12rpx;box-sizing:border-box;width:100%;min-height:68rpx}.note-input{min-height:150rpx}.notice{text-align:center;color:#78849a;font-size:23rpx;padding:20rpx}
