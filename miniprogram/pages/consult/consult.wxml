<view class="page">
  <view class="hero card"><view class="eyebrow">狮山智生活</view><view class="title">{{type}}咨询预约</view><view class="context" wx:if="{{interest}}"><text class="context-label">当前业务</text><text>{{interest}}</text></view><view class="muted">提交后，客服将在 {{responseHours}} 小时内联系你确认方案</view></view>
  <view class="form card"><view class="field"><text class="field-label">姓名</text><input class="input" placeholder="请输入姓名" bindinput="setName"/></view><view class="field"><text class="field-label">手机号</text><input class="input" type="number" maxlength="11" placeholder="用于接收联系" bindinput="setPhone"/></view><view class="field"><text class="field-label">预计办理时间</text><input class="input" placeholder="例如：本周内" bindinput="setTime"/></view><view class="field"><text class="field-label">补充需求</text><textarea class="input note-input" placeholder="请补充你的具体需求" bindinput="setNote"/></view><button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '提交中…' : '提交' + type + '咨询'}}</button></view>
  <view class="notice">客服微信/电话：{{contact}}</view>
</view>
