.empty { padding: 70rpx 38rpx; text-align: center; }.empty-icon { width: 100rpx; height: 100rpx; line-height: 100rpx; margin: 0 auto 22rpx; border-radius: 50%; background: #edf2ff; color: #1746a2; font-size: 42rpx; font-weight: 900; }.empty-title { font-size: 32rpx; font-weight: 900; margin-bottom: 12rpx; }.empty button { margin-top: 30rpx; }.order { padding: 26rpx; margin-bottom: 20rpx; }.order-head,.order-bottom { display: flex; align-items: center; justify-content: space-between; }.status { color: #9a7200; background: #fff7cf; border-radius: 999rpx; padding: 8rpx 14rpx; font-size: 21rpx; }.product-name { font-size: 32rpx; font-weight: 900; margin: 26rpx 0 10rpx; }.meta { color: #78849a; font-size: 23rpx; line-height: 1.6; }.order-bottom { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f5; }.order-bottom button { margin: 0; }
