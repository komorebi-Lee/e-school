.page-title { font-size: 42rpx; font-weight: 900; margin: 8rpx 0 22rpx; }
.linkage { display: grid; gap: 14rpx; margin-bottom: 20rpx; }
.linkage-item { display: flex; align-items: center; gap: 18rpx; background: #002fa7; color: #fff; border-radius: 24rpx; padding: 22rpx; box-shadow: 0 12rpx 26rpx rgba(0,47,167,.16); }
.linkage-icon { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.14); border-radius: 20rpx; font-weight: 900; }
.linkage-title { font-size: 27rpx; font-weight: 800; }
.linkage-copy { color: #d7e2ff; font-size: 21rpx; margin-top: 6rpx; }
.linkage-item .arrow { margin-left: auto; color: #c8d8ff; font-size: 34rpx; }
.tabs { white-space: nowrap; margin: 0 -28rpx 22rpx; padding: 0 28rpx; }
.tabs-inner { display: inline-flex; gap: 12rpx; padding-bottom: 4rpx; }
.tab { display: inline-flex; align-items: center; height: 60rpx; padding: 0 24rpx; border-radius: 999rpx; background: #fff; color: #536078; font-size: 23rpx; box-shadow: 0 6rpx 16rpx rgba(0,47,167,.06); }
.tab.active { background: #002fa7; color: #fff; font-weight: 800; }
.loading { text-align: center; padding: 40rpx 0; }
.empty { padding: 64rpx 34rpx; text-align: center; }
.empty-icon { width: 96rpx; height: 96rpx; line-height: 96rpx; margin: 0 auto 20rpx; background: #eaf0ff; color: #002fa7; border-radius: 50%; font-weight: 900; }
.empty-title { font-size: 31rpx; font-weight: 900; margin-bottom: 10rpx; }
.empty-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.empty-actions button { flex: 1; margin: 0; }
.record { padding: 25rpx; margin-bottom: 18rpx; }
.record-head { display: flex; justify-content: space-between; align-items: center; }
.record-type { display: inline-flex; align-items: center; gap: 12rpx; font-size: 22rpx; color: #536078; font-weight: 700; }
.record-icon { width: 46rpx; height: 46rpx; display: inline-flex; align-items: center; justify-content: center; border-radius: 14rpx; background: #eaf0ff; color: #002fa7; font-size: 20rpx; font-weight: 900; }
.status { border-radius: 999rpx; padding: 7rpx 14rpx; font-size: 20rpx; font-weight: 800; }
.tone-todo { color: #9a7200; background: #fff7cf; }
.tone-run { color: #0f5fd8; background: #e8f0ff; }
.tone-done { color: #157552; background: #dcf7ea; }
.tone-warn { color: #b42318; background: #ffe9e6; }
.tone-closed { color: #667289; background: #eef1f5; }
.record-title { font-size: 31rpx; font-weight: 900; margin: 20rpx 0 10rpx; }
.record-meta { display: flex; justify-content: space-between; color: #78849a; font-size: 21rpx; }
.delivery-row { display: flex; gap: 16rpx; align-items: flex-start; margin-top: 16rpx; padding: 16rpx; background: #f7f9ff; border-radius: 14rpx; color: #33435f; font-size: 21rpx; line-height: 1.5; }
.record-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f5; }
.record-actions { display: flex; gap: 12rpx; flex-wrap: wrap; justify-content: flex-end; }
.record-actions button { margin: 0; font-size: 22rpx; padding: 0 20rpx; }
.disabled { opacity: .45; }
.action-tip { font-size: 20rpx; margin-top: 12rpx; text-align: right; }
.collab { margin-top: 18rpx; background: #f7f9ff; border-radius: 18rpx; padding: 18rpx; }
.collab-row { display: flex; gap: 12rpx; font-size: 22rpx; margin-bottom: 8rpx; }
.collab-row .muted { min-width: 72rpx; }
.message { display: flex; gap: 12rpx; font-size: 22rpx; margin-top: 8rpx; color: #536078; }
.role { flex: 0 0 auto; font-size: 18rpx; padding: 3rpx 8rpx; border-radius: 999rpx; background: #eaf0ff; color: #002fa7; font-weight: 800; }
.role-MERCHANT { background: #fff2d9; color: #9a5b00; }
.role-PLATFORM { background: #e6f7f0; color: #157552; }
.alert { margin-top: 10rpx; color: #b42318; background: #ffe9e6; border-radius: 12rpx; padding: 10rpx; font-size: 21rpx; font-weight: 700; }
.consult-mask { position: fixed; inset: 0; z-index: 999; background: rgba(15, 24, 44, .52); display: flex; align-items: flex-end; }
.consult-sheet { width: 100%; box-sizing: border-box; min-height: 62vh; max-height: 86vh; overflow: auto; background: linear-gradient(180deg, #f6f8ff 0%, #fff 34%); border-radius: 30rpx 30rpx 0 0; padding: 14rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); }
.sheet-grip { width: 72rpx; height: 7rpx; margin: 6rpx auto 22rpx; border-radius: 999rpx; background: #d8dfec; }
.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.sheet-title { font-size: 35rpx; font-weight: 900; color: #17233d; }
.sheet-copy { margin-top: 8rpx; font-size: 22rpx; color: #78849a; }
.sheet-close { width: 54rpx; height: 54rpx; line-height: 50rpx; text-align: center; border-radius: 50%; background: #edf1f8; color: #667289; font-size: 34rpx; }
.order-context { margin-top: 24rpx; border: 1rpx solid #dce6ff; background: #fff; border-radius: 22rpx; padding: 22rpx; box-shadow: 0 10rpx 24rpx rgba(0,47,167,.05); }
.context-title { font-size: 29rpx; font-weight: 850; color: #202b45; }
.context-meta { display: flex; justify-content: space-between; gap: 18rpx; margin-top: 12rpx; font-size: 21rpx; color: #78849a; }
.quick-title { margin: 28rpx 2rpx 15rpx; font-size: 24rpx; font-weight: 850; color: #17233d; }
.quick-grid { display: grid; gap: 13rpx; }
.quick-question { display: flex; align-items: center; min-height: 76rpx; margin: 0; padding: 10rpx 22rpx; border: 1rpx solid #e3e9f5; border-radius: 19rpx; background: #fff; color: #33435f; font-size: 24rpx; text-align: left; line-height: 1.35; }
.quick-question::after { border: 0; }
.sheet-actions { display: grid; grid-template-columns: 1fr auto; gap: 12rpx; margin-top: 28rpx; }
.sheet-actions button { min-height: 80rpx; margin: 0; padding: 0 22rpx; border-radius: 19rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 800; }
.sheet-actions button::after { border: 0; }
.support-button { grid-column: 1 / 3; background: #002fa7; color: #fff; }
.phone-button { background: #eaf0ff; color: #002fa7; }
.note-button { min-width: 220rpx; background: #fff; border: 1rpx solid #d8dfec; color: #33435f; }
.form-fallback { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f5; text-align: center; color: #0f5fd8; font-size: 22rpx; font-weight: 650; }
.sending { margin-top: 14rpx; text-align: center; font-size: 21rpx; }
