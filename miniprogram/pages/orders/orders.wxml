<view class="page">
  <view class="page-title">我的服务</view>
  <view class="linkage" wx:if="{{linkage.length}}">
    <view class="linkage-item" wx:for="{{linkage}}" wx:key="title" data-view="{{item.view}}" data-filter="{{item.filter}}" bindtap="goLinkage">
      <view class="linkage-icon">{{item.icon}}</view>
      <view><view class="linkage-title">{{item.title}}</view><view class="muted linkage-copy">{{item.copy}}</view></view>
      <text class="arrow">›</text>
    </view>
  </view>
  <scroll-view class="tabs" scroll-x show-scrollbar="{{false}}">
    <view class="tabs-inner">
      <view class="tab {{active === 'ALL' ? 'active' : ''}}" data-type="ALL" bindtap="setFilter">全部</view>
      <view class="tab {{active === 'E_BIKE' ? 'active' : ''}}" data-type="E_BIKE" bindtap="setFilter">电瓶车</view>
      <view class="tab {{active === 'PHONE_PLAN' ? 'active' : ''}}" data-type="PHONE_PLAN" bindtap="setFilter">电话卡</view>
      <view class="tab {{active === 'RECHARGE' ? 'active' : ''}}" data-type="RECHARGE" bindtap="setFilter">话费权益</view>
      <view class="tab {{active === 'BROADBAND' ? 'active' : ''}}" data-type="BROADBAND" bindtap="setFilter">宽带</view>
      <view class="tab {{active === 'PLATE' ? 'active' : ''}}" data-type="PLATE" bindtap="setFilter">牌照</view>
    </view>
  </scroll-view>
  <view class="loading muted" wx:if="{{loading}}">正在同步服务记录…</view>
  <view wx:if="{{!loading && filtered.length === 0}}" class="empty card"><view class="empty-icon">单</view><view class="empty-title">还没有服务记录</view><view class="muted">购车后可自动办理校园牌照，买卡后可申请宽带。</view><view class="empty-actions"><button class="ghost-button" bindtap="goCard">买电话卡</button><button class="primary-button" bindtap="goShop">买电瓶车</button></view></view>
  <view class="record card" wx:for="{{filtered}}" wx:key="id">
    <view class="record-head"><view class="record-type"><text class="record-icon">{{item.icon}}</text>{{item.typeLabel}}</view><text class="status tone-{{item.tone}}">{{item.statusLabel}}</text></view>
    <view class="record-title">{{item.title}}</view>
    <view class="delivery-code" wx:if="{{item.deliveryCode}}">
      <view class="code-meta"><text class="code-label">{{item.status === 'COMPLETED' ? '已核验交付码' : '交付码'}}</text><text class="code-hint">{{item.status === 'FULFILLING' ? '配送时向商家出示' : '已核验，可留存备查'}}</text></view>
      <view class="code-value">{{item.deliveryCode}}</view>
      <button class="code-copy" data-code="{{item.deliveryCode}}" bindtap="copyDeliveryCode">复制</button>
    </view>
    <view class="delivery-row" wx:if="{{item.deliveryText}}"><text class="muted">配送</text><text>{{item.deliveryText}}</text></view>
    <view class="record-meta"><text>{{item.recordNo}}</text><text>{{item.timeText}}</text></view>
    <view class="collab" wx:if="{{item.collaboration}}">
      <view class="collab-row"><text class="muted">商家</text><text>{{item.merchantName || '平台自营'}}</text></view>
      <view class="collab-row"><text class="muted">下一步</text><text>{{item.nextStep}}</text></view>
      <view class="timeline" wx:if="{{item.timeline.length}}">
        <view class="timeline-title">履约轨迹</view>
        <view class="timeline-item" wx:for="{{item.timeline}}" wx:for-item="event" wx:key="id"><text class="timeline-dot"></text><view><view><text class="timeline-role">{{event.roleLabel}}</text><text class="timeline-note">{{event.note}}</text></view><view class="muted timeline-time">{{event.timeText}}</view></view></view>
      </view>
      <view class="message" wx:for="{{item.messages}}" wx:for-item="message" wx:key="id"><text class="role role-{{message.role}}">{{message.role === 'MERCHANT' ? '商家' : message.role === 'PLATFORM' ? '平台' : '我'}}</text><text>{{message.text}}</text></view>
      <view class="alert" wx:if="{{item.intervention}}">已提交平台协助</view>
    </view>
    <view class="record-bottom"><text class="price" wx:if="{{item.priceText}}">{{item.priceText}}</text><text class="muted" wx:else>金额确认后展示</text><view class="record-actions"><block wx:for="{{item.actions}}" wx:for-item="action" wx:key="key"><button size="mini" class="{{action.disabled ? 'ghost-button disabled' : 'ghost-button'}}" data-id="{{item.id}}" data-action="{{action.action}}" data-business="{{action.business}}" data-interest="{{item.title}}" data-product-id="{{action.productId}}" data-recharge-id="{{item.rechargeId}}" bindtap="{{action.key === 'pay' ? 'runPayment' : (action.key === 'cancel' ? 'cancelOrder' : (action.key === 'consult' ? 'runConsult' : (action.key === 'collab' || action.key === 'appeal' ? 'sendCollab' : (action.type === 'review' ? 'openReview' : (action.action ? 'runAction' : (action.filter ? 'goLinkage' : (action.rechargeId ? 'goRechargeDetail' : 'runConsult')))))))}}" disabled="{{action.disabled}}">{{action.text}}</button></block></view></view>
    <view class="action-tip muted" wx:if="{{item.actions.length === 1 && item.actions[0].disabled}}">{{item.actions[0].reason}}</view>
  </view>
  <view class="consult-mask" wx:if="{{consult}}" bindtap="closeConsult" catchtouchmove="keepConsultOpen">
    <view class="consult-sheet" catchtap="keepConsultOpen">
      <view class="sheet-grip"></view>
      <view class="sheet-head">
        <view><view class="sheet-title">{{consult.business}}</view><view class="sheet-copy">已关联订单，客服可直接看到业务和状态</view></view>
        <view class="sheet-close" bindtap="closeConsult">×</view>
      </view>
      <view class="order-context">
        <view class="context-title">{{consult.title}}</view>
        <view class="context-meta"><text>{{consult.recordNo}}</text><text>{{consult.statusLabel}}</text></view>
      </view>
      <view class="quick-title">常见问题</view>
      <view class="quick-grid">
        <button wx:for="{{consult.questions}}" wx:key="*this" class="quick-question" data-question="{{item}}" bindtap="sendConsultQuestion" disabled="{{consult.sending}}">{{item}}</button>
      </view>
      <view class="sheet-actions">
        <button class="support-button" open-type="contact" session-from="{{consult.sessionFrom}}" send-message-title="{{consult.title}}" send-message-path="/pages/orders/orders" show-message-card="{{true}}" bindcontact="onContact">微信客服会话</button>
        <button class="phone-button" bindtap="callConsultPhone">电话客服</button>
        <button class="note-button" bindtap="describeConsult" disabled="{{consult.sending}}">补充说明</button>
      </view>
      <view class="form-fallback" bindtap="goConsultForm">问题较复杂？使用预约表单（24 小时回访）</view>
      <view class="sending muted" wx:if="{{consult.sending}}">正在提交：{{consult.sending}}</view>
    </view>
  </view>
</view>
