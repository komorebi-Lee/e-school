<view class="page"><view wx:if="{{orders.length === 0}}" class="empty card"><view class="empty-icon">单</view><view class="empty-title">还没有服务记录</view><view class="muted">提交咨询后，客服会在 24 小时内联系。</view><button class="ghost-button" bindtap="goShop">去选车</button></view><view wx:for="{{orders}}" wx:key="id" class="order card"><view class="order-head"><text class="muted">{{item.id}}</text><text class="status">咨询中</text></view><view class="product-name">{{item.productName}}</view><view class="meta">已提交咨询 · 客服将在 24 小时内联系</view><view class="order-bottom"><button size="mini" class="ghost-button" data-id="{{item.id}}" bindtap="editOrder">修改信息</button><button size="mini" class="primary-button" data-id="{{item.id}}" bindtap="afterSales">申请售后</button></view></view></view>
