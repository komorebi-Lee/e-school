<view class="page"><view class="order-ref">订单 {{orderId}}</view><view class="form card"><view class="field"><text class="field-label">联系人</text><input class="input" value="{{name}}" placeholder="请输入姓名" bindinput="setName"/></view><view class="field"><text class="field-label">联系电话</text><input class="input" type="number" maxlength="11" value="{{phone}}" placeholder="用于接收联系" bindinput="setPhone"/></view><view class="field"><text class="field-label">期望配送时间</text><input class="input" value="{{time}}" placeholder="例如：本周六下午" bindinput="setTime"/></view><view class="field"><text class="field-label">补充备注</text><textarea class="input textarea" value="{{note}}" placeholder="车辆颜色、宿舍楼等信息" bindinput="setNote"></textarea></view><button class="primary-button" bindtap="save">保存修改</button></view></view>
