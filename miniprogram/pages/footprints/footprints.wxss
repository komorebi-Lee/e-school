.page { padding: 20rpx 24rpx; }
.summary { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 22rpx; color: #536078; font-size: 22rpx; margin-bottom: 18rpx; }
/* 左列：条数 + 去重说明。`min-width: 0` 让长文案能换行而不是把按钮挤出去。 */
.summary-main { flex: 1; min-width: 0; }
.summary-note { margin-top: 6rpx; font-size: 20rpx; line-height: 1.45; }
/* 清空按钮：不抢宽度，但也不被压扁。 */
.clear-button { min-width: 150rpx; margin: 0; flex-shrink: 0; }
.footprint-card { display: flex; align-items: center; padding: 22rpx; margin-bottom: 15rpx; }
.product-type { width: 94rpx; padding: 18rpx 8rpx; border-radius: 15rpx; text-align: center; font-size: 20rpx; font-weight: 900; }
.scooter-type { background: #fff1b8; color: #7c5c00; }
.product-main { flex: 1; margin-left: 18rpx; min-width: 0; }
.product-name { font-size: 27rpx; font-weight: 900; }
.product-desc { font-size: 20rpx; margin-top: 5rpx; }
.promo-badge { display: inline-flex; margin-top: 8rpx; color: #002fa7; background: #eaf0ff; border-radius: 999rpx; padding: 5rpx 14rpx; font-size: 19rpx; font-weight: 800; }
.price-group { text-align: right; }
.original-price { display: block; color: #78849a; font-size: 18rpx; text-decoration: line-through; }
.product-price { color: #002fa7; font-size: 29rpx; font-weight: 900; }
.empty { padding: 40rpx 24rpx; }

/* 失败占位：接口挂掉必须「看得见、点得动」，而不是安静地显示空列表。 */
.load-error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx 24rpx; margin: 0 0 18rpx; background: #fff4f2; border: 2rpx solid #ffd9d3; border-radius: 18rpx; }
.load-error .muted { flex: 1; min-width: 0; color: #a3341f; line-height: 1.45; }
.load-error .ghost-button { min-width: 120rpx; margin: 0; flex-shrink: 0; }
