<view class="page market-page">
  <view class="head card">
    <view class="head-copy">
      <view class="head-title">狮山市集</view>
      <view class="muted small">校内自提 · 二手书 / 生活用品 / 数码</view>
    </view>
    <view class="head-actions">
      <button class="ghost-button" size="mini" bindtap="goForum">学校论坛</button>
      <button class="primary-button" size="mini" bindtap="goPublish">发布闲置</button>
    </view>
  </view>

  <view class="search-bar card">
    <input class="search-input" placeholder="搜索市集好物…" value="{{query}}" bindinput="setSearch" confirm-type="search" />
  </view>

  <scroll-view class="chips" scroll-x show-scrollbar="{{false}}">
    <view class="chip-inner">
      <view wx:for="{{categoryOptions}}" wx:key="key" class="chip {{activeCategory === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="setCategory">{{item.label}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="empty card"><view class="muted">正在加载市集好物…</view></view>
  <block wx:else>
    <view class="item card" wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="goItem">
      <image class="item-cover" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover}}" />
      <view class="item-main">
        <view class="item-title">{{item.title}}</view>
        <view class="muted small item-desc">{{item.description}}</view>
        <view class="item-meta">
          <text class="tag">{{item.categoryText}}</text>
          <text class="tag">{{item.conditionText}}</text>
          <text class="tag" wx:if="{{item.statusText !== '在售'}}">{{item.statusText}}</text>
        </view>
        <view class="item-foot">
          <text class="price">{{item.priceText}}</text>
          <text class="muted small">{{item.sellerName}} · {{item.timeText}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{!filtered.length}}" class="empty card">
      <view class="empty-title">暂时没有符合条件的闲置</view>
      <view class="muted">换个分类看看，或者发布你的闲置。</view>
      <view class="empty-actions">
        <button size="mini" class="ghost-button" bindtap="goForum">去逛论坛</button>
        <button size="mini" class="primary-button" bindtap="goPublish">发布闲置</button>
      </view>
    </view>
  </block>
</view>
