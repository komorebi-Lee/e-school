<view class="page">
  <!-- 失败占位：接口挂了必须说出来，并且能重试。旧列表（若有）仍显示在下方。 -->
  <view wx:if="{{itemsBlock.error}}" class="load-error card">
    <view class="muted">{{itemsBlock.error}}</view>
    <button size="mini" class="ghost-button" bindtap="retryItems">重试</button>
  </view>

  <view wx:if="{{itemsBlock.loading && !itemsBlock.data.length}}" class="empty card"><view class="muted">正在加载你发布的闲置…</view></view>
  <!-- 空态：必须同时「不在加载」且「没有错误」，否则失败会被说成「你还没有发布过闲置」 -->
  <view wx:elif="{{!itemsBlock.data.length && !itemsBlock.error}}" class="empty card">
    <view class="muted">你还没有发布过闲置</view>
    <button size="mini" class="primary-button" bindtap="goPublish">去发布</button>
  </view>
  <block wx:else>
    <view class="summary card" wx:if="{{itemsBlock.data.length}}">共 {{itemsBlock.data.length}} 条闲置</view>
    <view class="mine-card card" wx:for="{{itemsBlock.data}}" wx:key="id" data-id="{{item.id}}" bindtap="goItem">
      <image class="item-cover" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover}}" />
      <view class="mine-head">
        <!-- 状态必须显示出来：这一页是唯一能看到「已售 / 已删除 / 已下架」的地方，
             看不出状态，用户就不知道自己的闲置现在是什么处境。 -->
        <text class="status-tag {{item.statusClass}}">{{item.statusText}}</text>
        <text class="muted small">{{item.timeText}}</text>
      </view>
      <view class="mine-title">{{item.title}}</view>
      <view class="muted small mine-desc">{{item.description}}</view>
      <view class="mine-foot">
        <text class="price">{{item.priceText}}</text>
        <text class="muted small">{{item.categoryText}} · {{item.conditionText}}</text>
      </view>
      <view class="mine-actions" wx:if="{{item.deletable || item.lockedText}}">
        <!-- `catchtap` 而不是 `bindtap`：这个按钮在整张卡片（bindtap="goItem"）里面，
             不拦住冒泡的话点「删除」会顺带跳进详情页。 -->
        <button
          wx:if="{{item.deletable}}"
          size="mini"
          class="ghost-button danger-button"
          data-id="{{item.id}}"
          catchtap="deleteItem"
          disabled="{{deletingId === item.id}}"
        >{{deletingId === item.id ? '删除中…' : '删除'}}</button>
        <!-- 不可删除时说明原因，而不是把按钮悄悄拿掉 —— 否则用户以为页面坏了。 -->
        <text wx:else class="muted small locked-note">{{item.lockedText}}</text>
      </view>
    </view>
  </block>
</view>
