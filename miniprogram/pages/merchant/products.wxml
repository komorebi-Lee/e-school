<view class="page">
  <view class="metric-strip card" wx:if="{{metrics}}">
    <view><text class="metric-value">{{metrics.productCount}}</text><text class="muted">在售商品</text></view>
  <view><text class="metric-value warning">{{metrics.lowStockCount}}</text><text class="muted">可售偏低</text></view>
    <view><text class="metric-value">{{metrics.orderCount}}</text><text class="muted">订单</text></view>
  </view>
  <view class="page-title">{{editId ? '编辑商品' : '新增商品'}}</view>
  <view class="form card">
    <view class="field"><text class="field-label">商品名称</text><input class="input" value="{{form.name}}" data-field="name" bindinput="setField" placeholder="请输入商品名称" /></view>
    <view class="field"><text class="field-label">类目</text><picker range="{{categories}}" range-key="label" value="{{form.categoryIndex}}" bindchange="setCategory"><view class="input">{{categories[form.categoryIndex].label}} ▾</view></picker></view>
    <view class="row">
      <view class="field half"><text class="field-label">价格（元）</text><input class="input" type="digit" value="{{form.price}}" data-field="price" bindinput="setField" /></view>
      <view class="field half"><text class="field-label">库存</text><input class="input" type="number" value="{{form.stock}}" data-field="stock" bindinput="setField" /></view>
    </view>
    <view class="field"><text class="field-label">商品简介</text><textarea class="input textarea" value="{{form.description}}" data-field="description" bindinput="setField" maxlength="300" /></view>
    <view class="field">
      <text class="field-label">商品图片</text>
      <view class="image-picker" wx:if="{{form.imageUrl}}">
        <image src="{{form.imageUrl}}" mode="aspectFill" />
        <button size="mini" class="ghost-button" bindtap="removeImage">移除</button>
      </view>
      <button size="mini" class="ghost-button" wx:else bindtap="chooseImage">上传图片</button>
      <view class="muted">建议正方形实拍图，JPG/PNG/WebP，不超过 5MB。</view>
    </view>
    <view class="switch-row"><text>上架销售</text><switch checked="{{form.active}}" bindchange="setActive" color="#002FA7" /></view>
    <view class="form-actions">
      <button size="mini" class="ghost-button" bindtap="reset">{{editId ? '取消编辑' : '清空表单'}}</button>
      <button size="mini" class="primary-button" bindtap="submit">保存商品</button>
    </view>
  </view>

  <view class="operations card">
    <input class="input search" placeholder="搜索商品或简介" value="{{query}}" bindinput="setSearch" />
    <view class="filter-row">
      <view wx:for="{{filters}}" wx:key="key" class="filter-tab {{filter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="setFilter">{{item.label}}</view>
    </view>
  </view>
  <view class="section-title">商品列表</view>
  <view wx:if="{{loading}}" class="empty card"><view class="muted">正在加载…</view></view>
  <view wx:elif="{{!filtered.length}}" class="empty card"><view class="muted">没有匹配商品</view></view>
  <block wx:else>
    <view class="product card" wx:for="{{filtered}}" wx:key="id">
      <view class="product-head"><image wx:if="{{item.imageUrl}}" class="product-thumb" src="{{item.imageUrl}}" mode="aspectFill" /><view class="head"><view class="strong">{{item.name}}</view><text class="{{item.active ? 'on' : 'off'}}">{{item.active ? '销售中' : '已下架'}}</text></view></view>
      <view class="category-row"><text class="category">{{item.categoryLabel}}</text><text class="{{item.sellableStock < 10 ? 'stock-low' : 'stock'}}">{{item.stockText}}</text></view>
      <view class="muted">{{item.description}}</view>
      <view class="risk-note" wx:if="{{item.autoDelisted}}">已自动下架：{{item.autoDelistText}}</view>
      <view class="bottom"><text class="price">¥{{item.priceInCents / 100}}</text><text class="muted">{{item.stockDetailText}}</text></view>
      <view class="actions">
        <button size="mini" class="ghost-button" data-id="{{item.id}}" bindtap="restock">补货</button>
        <button size="mini" class="ghost-button" data-id="{{item.id}}" bindtap="select">编辑</button>
        <button size="mini" class="{{item.active ? 'ghost-button' : 'primary-button'}}" data-id="{{item.id}}" data-active="{{item.active}}" bindtap="toggle">{{item.active ? '下架' : '上架'}}</button>
      </view>
    </view>
  </block>
</view>
