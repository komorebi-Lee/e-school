.merchant { display: flex; justify-content: space-between; align-items: center; padding: 28rpx; }
.merchant-name { font-size: 36rpx; font-weight: 900; }
.status { color: #157552; background: #dcf7ea; padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 800; }
.notification { padding: 24rpx; margin-top: 20rpx; }
.workbench { padding: 24rpx; margin-top: 20rpx; }
.workbench-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.workbench-head .ghost-button { min-width: 132rpx; margin: 0; }
.workbench-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 20rpx; }
.workbench-metric { padding: 20rpx; border-radius: 18rpx; background: linear-gradient(135deg, #002fa7, #2450c4); color: #fff; display: flex; flex-direction: column; gap: 8rpx; }
.workbench-metric text { color: rgba(255, 255, 255, .78); font-size: 21rpx; }
.workbench-metric strong { font-size: 38rpx; font-weight: 900; line-height: 1.1; }
.workbench-metric.metric-link { position: relative; }
.metric-go { color: rgba(255, 255, 255, .85); font-size: 20rpx; }
.workbench-today { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 12rpx; }
.today-item { padding: 14rpx 16rpx; border: 1rpx solid #e3e9f5; border-radius: 16rpx; background: #f8fafc; text-align: center; }
.today-item text { display: block; color: #78849a; font-size: 20rpx; }
.today-item strong { display: block; margin-top: 4rpx; color: #1f2733; font-size: 30rpx; font-weight: 900; }
.workbench-alerts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; margin-top: 16rpx; }
.workbench-alert { padding: 16rpx 10rpx; border: 1rpx solid #e3e9f5; border-radius: 16rpx; background: #f8fafc; text-align: center; }
.workbench-alert text { display: block; color: #78849a; font-size: 20rpx; line-height: 1.3; }
.workbench-alert strong { display: block; margin-top: 6rpx; color: #1f2733; font-size: 30rpx; font-weight: 900; line-height: 1.1; }
.workbench-alert.attention { border-color: #f3c9c4; background: #fff6f5; }
.workbench-alert.attention strong { color: #c0392b; }
.quick-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 20rpx; }
.quick-action { padding: 18rpx 12rpx; border: 1rpx solid #e3e9f5; border-radius: 18rpx; background: #fff; }
.quick-icon { width: 66rpx; height: 34rpx; line-height: 34rpx; border-radius: 999rpx; background: #eaefff; color: #002fa7; text-align: center; font-size: 19rpx; font-weight: 800; }
.quick-action .strong { margin-top: 12rpx; font-size: 24rpx; }
.quick-action text { display: block; margin-top: 5rpx; color: #78849a; font-size: 19rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.workbench-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8rpx; margin-top: 20rpx; padding: 8rpx; border-radius: 18rpx; background: #f1f4fa; }
.workbench-tab { height: 62rpx; line-height: 62rpx; border-radius: 14rpx; text-align: center; color: #5d6b82; font-size: 24rpx; font-weight: 750; }
.workbench-tab.active { background: #fff; color: #002fa7; box-shadow: 0 4rpx 14rpx rgba(0, 47, 167, .08); }
.tab-main { display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.tab-badge { min-width: 32rpx; height: 32rpx; line-height: 32rpx; padding: 0 8rpx; border-radius: 999rpx; background: #eaefff; color: #002fa7; font-size: 19rpx; font-weight: 850; box-sizing: border-box; }
.tab-badge.alert { background: #c0392b; color: #fff; }
.notice-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.notice-item { padding: 16rpx 0; border-bottom: 1rpx solid #edf0f5; }
.notice-item:last-child { border-bottom: 0; }
.notice-item .muted { margin-top: 6rpx; line-height: 1.45; }
.notice-action { cursor: pointer; }
.notice-action .notice-link { margin-left: 12rpx; color: #002fa7; font-weight: 750; }
.notice-time { font-size: 20rpx; }
.metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 22rpx; }
.metric { padding: 24rpx; display: flex; flex-direction: column; gap: 8rpx; }
.metric text { color: #78849a; font-size: 22rpx; }
.metric strong { font-size: 36rpx; font-weight: 900; color: #002fa7; }
.order { display: flex; justify-content: space-between; align-items: center; padding: 26rpx; margin-top: 18rpx; }
.section-row { display: flex; align-items: center; justify-content: space-between; }
.section-more { font-size: 24rpx; color: #2563eb; font-weight: 600; }
.workbench-order { position: relative; }
.order-link { margin-top: 6rpx; font-size: 24rpx; color: #2563eb; }
.health { display: flex; align-items: center; gap: 20rpx; margin-top: 18rpx; }
.health-score { display: flex; flex-direction: column; align-items: center; min-width: 132rpx; padding: 10rpx 16rpx; border-radius: 16rpx; background: #f1f5ff; }
.health-number { font-size: 44rpx; font-weight: 900; line-height: 1.1; color: #002fa7; }
.health-score .status-text { font-size: 20rpx; margin-top: 4rpx; }
.health-main { flex: 1; }
.health-go { font-size: 24rpx; color: #2563eb; font-weight: 600; }
.strong { font-weight: 800; }
.right { text-align: right; }
.settle-main { flex: 1; padding-right: 18rpx; }
.stage-hint { font-size: 20rpx; margin-top: 6rpx; line-height: 1.4; }
.status-text { margin-top: 6rpx; font-size: 22rpx; font-weight: 800; }
.tone-todo { color: #b26a00; }
.tone-done { color: #157552; }
.tone-blue { color: #002fa7; }
.tone-warn { color: #c0392b; }
.settle-panel { padding: 26rpx; margin-top: 18rpx; }
.settle-head { display: flex; justify-content: space-between; align-items: flex-end; }
.settle-amount { font-size: 44rpx; font-weight: 900; color: #002fa7; }
.settle-flow { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 16rpx 0; border-top: 1rpx solid #edf0f5; border-bottom: 1rpx solid #edf0f5; }
.settle-cells { display: flex; flex-wrap: wrap; gap: 12rpx 0; margin-top: 16rpx; }
.settle-cell { width: 33.3%; display: flex; flex-direction: column; gap: 4rpx; }
.settle-cell text { color: #78849a; font-size: 20rpx; }
.settle-cell strong { font-size: 28rpx; font-weight: 800; color: #1f2733; }
.settle-cell strong.warn { color: #c0392b; }
.payout-action { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0f5; }
.payout-hint { flex: 1; font-size: 22rpx; color: #4a5568; line-height: 1.45; }
.payout-button { margin: 0; padding: 0 28rpx; height: 64rpx; line-height: 64rpx; font-size: 24rpx; font-weight: 800; color: #fff; background: #002fa7; border-radius: 999rpx; }
.payout-button.disabled { background: #cbd3e1; color: #f2f5fa; }
.payout-note { font-size: 20rpx; margin-top: 12rpx; }
.sla { border-left: 6rpx solid #c0392b; }
.risk-status { display: inline-flex; margin-left: 12rpx; margin-top: 0; padding: 2rpx 12rpx; border-radius: 999rpx; background: #eaefff; }
.sla-item { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #edf0f5; }
.sla-item:last-of-type { border-bottom: 0; }
.sla-main { flex: 1; min-width: 0; }
.sla-main .muted { margin-top: 6rpx; line-height: 1.45; }
.sla-note { font-size: 20rpx; margin-top: 12rpx; }
.flow-step { display: flex; align-items: center; gap: 8rpx; }
.flow-index { width: 30rpx; height: 30rpx; line-height: 30rpx; text-align: center; border-radius: 999rpx; background: #eaefff; color: #002fa7; font-size: 18rpx; font-weight: 900; }
.flow-text { font-size: 20rpx; color: #4a5568; }
.flow-arrow { color: #c3cbd9; font-size: 24rpx; }
.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 26rpx; }
.action-grid button { margin: 0; }
.score { border-left: 6rpx solid #002fa7; }
.risk-urge-banner { margin-bottom: 18rpx; padding: 20rpx 22rpx; border: 1rpx solid #f3c9c4; border-left: 6rpx solid #b42318; border-radius: 18rpx; background: #ffe9e6; }
.pending-banner { margin-top: 18rpx; border-color: #cfe0ff; border-left-color: #2563eb; background: #eef4ff; }
.pending-banner .risk-urge-title { color: #2563eb; }
.risk-urge-title { font-size: 24rpx; font-weight: 750; color: #b42318; }
.risk-urge-content { margin-top: 8rpx; font-size: 22rpx; line-height: 1.45; color: #33435f; }
.risk-urge-meta { margin-top: 8rpx; font-size: 20rpx; color: #7a625d; }
.score-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.score-value { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.score-number { font-size: 46rpx; font-weight: 900; color: #002fa7; line-height: 1; }
.score-bars { margin-top: 18rpx; display: flex; flex-direction: column; gap: 14rpx; }
.score-bar-head { display: flex; justify-content: space-between; font-size: 22rpx; color: #4a5568; font-weight: 700; }
.score-track { margin-top: 6rpx; height: 10rpx; border-radius: 999rpx; background: #edf0f5; overflow: hidden; }
.score-fill { height: 100%; border-radius: 999rpx; background: #002fa7; }
.score-fill.tone-done { background: #1f8f4e; }
.score-fill.tone-todo { background: #d98219; }
.score-fill.tone-warn { background: #c0392b; }
.trend-block { margin-top: 20rpx; padding: 18rpx; border: 1rpx solid #e3e9f5; border-radius: 18rpx; background: #f8fafc; }
.trend-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.trend-title { font-size: 24rpx; }
.trend-chart { margin-top: 14rpx; height: 130rpx; display: flex; align-items: flex-end; gap: 5rpx; }
.trend-bar { position: relative; flex: 1; min-width: 8rpx; border-radius: 8rpx 8rpx 4rpx 4rpx; background: #002fa7; }
.trend-bar.tone-done { background: #1f8f4e; }
.trend-bar.tone-todo { background: #d98219; }
.trend-bar.tone-warn { background: #c0392b; }
.trend-tip { position: absolute; top: -34rpx; left: 50%; transform: translateX(-50%); font-size: 18rpx; color: #4a5568; font-weight: 750; white-space: nowrap; }
.trend-scale { display: flex; justify-content: space-between; margin-top: 10rpx; font-size: 19rpx; color: #718096; }
.trend-effect { margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx solid #e3e9f5; }
.trend-effect-label { font-size: 22rpx; font-weight: 750; color: #33435f; }
.trend-effect .muted { margin-top: 6rpx; font-size: 21rpx; line-height: 1.45; }
.trend-risk { margin-top: 14rpx; padding: 12rpx 14rpx; border-radius: 14rpx; background: #fff4f2; border: 1rpx solid #f3c9c4; }
.trend-risk-label { font-size: 22rpx; font-weight: 750; color: #c0392b; }
.trend-risk .muted { margin-top: 6rpx; font-size: 21rpx; line-height: 1.45; color: #7f2c22; }
.risk-task-block { margin-top: 20rpx; padding: 18rpx; border: 1rpx solid #f3c9c4; border-radius: 18rpx; background: #fff8f7; }
.risk-task-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.risk-task { margin-top: 14rpx; padding: 16rpx; border-radius: 16rpx; background: #fff; border: 1rpx solid #e3e9f5; display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.risk-task-main { flex: 1; min-width: 0; }
.risk-task-title { font-size: 24rpx; font-weight: 750; color: #33435f; }
.risk-task-detail { margin-top: 6rpx; font-size: 21rpx; line-height: 1.45; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.risk-task-due { margin-top: 6rpx; font-size: 20rpx; color: #c0392b; }
.risk-task-urge { margin-top: 6rpx; font-size: 20rpx; color: #a3341f; font-weight: 750; }
.risk-task-action { flex-shrink: 0; padding: 8rpx 16rpx; border-radius: 999rpx; background: #fff4f2; border: 1rpx solid #f3c9c4; color: #c0392b; font-size: 21rpx; font-weight: 750; }
.focus-item { border-color: #002fa7 !important; box-shadow: 0 0 0 4rpx rgba(0, 47, 167, .12) !important; }
.score-detail { font-size: 20rpx; margin-top: 6rpx; line-height: 1.45; }
.score-note { font-size: 20rpx; margin-top: 12rpx; line-height: 1.5; }
.score-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 24rpx; }
.score-actions .appeal-picker, .score-actions button { min-height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 24rpx; font-weight: 750; }
.score-actions .appeal-picker { grid-column: 1 / 3; background: #fff; border: 1rpx solid #d8dfec; color: #33435f; padding: 0 22rpx; }
.score-actions button { margin: 0; padding: 0; }
.score-actions button::after { border: 0; }
.score-case { margin-top: 18rpx; padding: 18rpx; background: #fff; border: 1rpx solid #e3e9f5; border-radius: 18rpx; }
.evidence-block { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0f5; }
.evidence-head { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; }
.evidence-head .ghost-button { min-width: 180rpx; margin: 0; }
.evidence-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 14rpx; }
.evidence-item { position: relative; }
.evidence-grid image { width: 100%; height: 150rpx; border-radius: 12rpx; background: #edf0f5; display: block; }
.evidence-remove { position: absolute; right: 8rpx; top: 8rpx; width: 36rpx; height: 36rpx; line-height: 34rpx; text-align: center; border-radius: 50%; background: rgba(17, 24, 39, .68); color: #fff; font-size: 24rpx; }
.score-case-head { display: flex; justify-content: space-between; gap: 16rpx; font-size: 23rpx; }
.score-case .muted { margin-top: 8rpx; font-size: 21rpx; line-height: 1.45; }

.rev-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 18rpx; }
.rev-toggle { display: flex; background: #f1f3f8; border-radius: 14rpx; padding: 4rpx; flex-shrink: 0; }
.rev-tab { font-size: 21rpx; color: #78849a; padding: 6rpx 18rpx; border-radius: 11rpx; }
.rev-tab.active { background: #fff; color: #002fa7; font-weight: 600; box-shadow: 0 2rpx 6rpx rgba(0, 47, 167, .12); }
.rev-bars { display: flex; align-items: flex-end; justify-content: space-between; gap: 6rpx; padding-top: 6rpx; }
.rev-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.rev-bar { width: 30rpx; height: 150rpx; display: flex; align-items: flex-end; }
.rev-bar-fill { width: 100%; background: linear-gradient(180deg, #335cff, #002fa7); border-radius: 8rpx 8rpx 0 0; min-height: 4rpx; }
.rev-bar-fill.today { background: linear-gradient(180deg, #ffb547, #ff8a00); }
.rev-value { font-size: 18rpx; color: #172033; margin-top: 10rpx; }
.rev-label { font-size: 19rpx; color: #78849a; margin-top: 4rpx; }
.rev-label.today { color: #002fa7; font-weight: 600; }
.rev-empty { padding: 40rpx 0; text-align: center; }
.notice-subscription { margin-bottom: 16rpx; }
.notice-subscription .ghost-button { min-width: 148rpx; margin: 0; }
.notice-subscription .muted { line-height: 1.5; }
.template-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 12rpx 0; border-bottom: 1rpx solid #edf0f5; }
.template-row:last-child { border-bottom: 0; }