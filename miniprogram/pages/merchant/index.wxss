.merchant { display: flex; justify-content: space-between; align-items: center; padding: 28rpx; }
.merchant-name { font-size: 36rpx; font-weight: 900; }
.status { color: #157552; background: #dcf7ea; padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 800; }
.metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 22rpx; }
.metric { padding: 24rpx; display: flex; flex-direction: column; gap: 8rpx; }
.metric text { color: #78849a; font-size: 22rpx; }
.metric strong { font-size: 36rpx; font-weight: 900; color: #002fa7; }
.order { display: flex; justify-content: space-between; align-items: center; padding: 26rpx; margin-top: 18rpx; }
.strong { font-weight: 800; }
.right { text-align: right; }
.status-text { margin-top: 6rpx; }
.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 26rpx; }
.action-grid button { margin: 0; }
