.page-title { font-size: 42rpx; font-weight: 900; margin: 8rpx 0 24rpx; }
.metric-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; padding: 22rpx; margin-bottom: 18rpx; }
.metric-strip view { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.metric-value { font-size: 32rpx; font-weight: 900; color: #002fa7; }
.metric-strip .muted { font-size: 20rpx; }
.filters { white-space: nowrap; margin: 0 -28rpx 20rpx; padding: 0 28rpx; }
.filter-inner { display: inline-flex; gap: 12rpx; }
.filter-tab { flex: 0 0 auto; height: 58rpx; line-height: 58rpx; padding: 0 24rpx; background: #fff; border-radius: 999rpx; color: #536078; font-size: 22rpx; font-weight: 700; box-shadow: 0 6rpx 16rpx rgba(0,47,167,.06); }
.filter-tab.active { background: #002fa7; color: #fff; }
.order { padding: 26rpx; margin-bottom: 18rpx; }
.head { display: flex; justify-content: space-between; align-items: center; }
.strong { font-weight: 900; }
.status { padding: 7rpx 14rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 800; }
.tone-PAID { color: #9a7200; background: #fff7cf; }
.tone-FULFILLING { color: #0f5fd8; background: #e8f0ff; }
.tone-COMPLETED { color: #157552; background: #dcf7ea; }
.tone-CANCELLED { color: #667289; background: #eef1f5; }
.items { margin: 18rpx 0; color: #536078; }
.delivery { margin-bottom: 18rpx; padding: 18rpx; border: 1rpx solid #dce6ff; border-radius: 16rpx; }
.delivery-title { font-size: 23rpx; font-weight: 800; color: #002fa7; margin-bottom: 12rpx; }
.bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 20rpx; border-top: 1rpx solid #edf0f5; }
.actions { display: flex; gap: 12rpx; }
.actions button { margin: 0; }
.collab { margin-top: 16rpx; background: #f7f9ff; border-radius: 18rpx; padding: 18rpx; }
.collab-row { display: flex; gap: 12rpx; font-size: 22rpx; margin-bottom: 8rpx; }
.collab-row .muted { min-width: 72rpx; }
.message { display: flex; gap: 12rpx; font-size: 22rpx; margin-top: 8rpx; color: #536078; }
.role { flex: 0 0 auto; font-size: 18rpx; padding: 3rpx 8rpx; border-radius: 999rpx; background: #eaf0ff; color: #002fa7; font-weight: 800; }
.alert { margin-top: 10rpx; color: #b42318; background: #ffe9e6; border-radius: 12rpx; padding: 10rpx; font-size: 21rpx; font-weight: 700; }
.aftersale-box { margin-top: 16rpx; background: #fff; border: 1rpx solid #ffd9d3; border-radius: 16rpx; padding: 18rpx; }
.aftersale-title { font-size: 23rpx; font-weight: 850; color: #b42318; }
.aftersale-reason { margin-top: 12rpx; color: #33435f; font-size: 22rpx; line-height: 1.5; }
.aftersale-meta { margin-top: 10rpx; font-size: 20rpx; }
.aftersale-actions { display: flex; gap: 12rpx; margin-top: 16rpx; justify-content: flex-end; }
.aftersale-actions button { margin: 0; }
.evidence-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 14rpx; }
.evidence-grid image { width: 100%; height: 130rpx; border-radius: 12rpx; background: #eef1f5; }
.aftersale-resolution { display: flex; gap: 10rpx; margin-top: 12rpx; padding: 12rpx; background: #f3faf6; border-radius: 12rpx; color: #157552; font-size: 21rpx; line-height: 1.5; }
.aftersale-resolution-label { flex: 0 0 auto; font-weight: 800; }
.timeline { margin-top: 16rpx; padding: 16rpx; background: #fff; border: 1rpx solid #e3e9f5; border-radius: 16rpx; }
.timeline-title { font-size: 23rpx; font-weight: 800; color: #172033; margin-bottom: 14rpx; }
.timeline-item { display: flex; gap: 14rpx; margin-bottom: 16rpx; }
.timeline-item:last-child { margin-bottom: 0; }
.timeline-dot { width: 14rpx; height: 14rpx; margin-top: 9rpx; border-radius: 50%; background: #002fa7; box-shadow: 0 0 0 6rpx #eaf0ff; }
.timeline-role { color: #002fa7; font-size: 20rpx; font-weight: 800; margin-right: 10rpx; }
.timeline-note { color: #33435f; font-size: 22rpx; line-height: 1.5; }
.timeline-time { font-size: 19rpx; margin-top: 5rpx; }
