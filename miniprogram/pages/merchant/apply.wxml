<view class="page">
  <view class="hero card">
    <view class="hero-title">商家入驻</view>
    <view class="muted">参考主流电商入驻流程：选择主体 → 准备资质 → 提交审核 → 开通工作台。</view>
    <view class="benefits">
      <view class="benefit">0入驻费</view>
      <view class="benefit">1-3个工作日审核</view>
      <view class="benefit">通过后直达工作台</view>
    </view>
  </view>

  <block wx:if="{{application}}">
    <view class="status card">
      <view class="status-head">
        <view>
          <view class="strong">{{application.name}}</view>
          <view class="muted">{{application.applicationNo || application.id}}</view>
        </view>
        <text class="badge {{application.status}}">{{statusLabels[application.status] || application.status}}</text>
      </view>
      <view class="steps">
        <view class="step done"><text>01</text><view><strong>提交材料</strong><small>营业执照 / 身份信息</small></view></view>
        <view class="step {{application.status === 'APPROVED' ? 'done' : 'active'}}"><text>02</text><view><strong>平台审核</strong><small>约1-3个工作日</small></view></view>
        <view class="step {{application.status === 'APPROVED' ? 'active' : ''}}"><text>03</text><view><strong>开通工作台</strong><small>管理商品和订单</small></view></view>
      </view>
      <view wx:if="{{application.status === 'REJECTED'}}" class="review-note">
        驳回原因：{{application.reviewNote || '资质材料不符合要求，请修改后重新提交'}}
      </view>
      <view wx:else class="review-note muted">平台正在核对资质材料、店铺信息与经营类目。</view>
    </view>
  </block>

  <block wx:else>
    <view class="section-title">选择开店主体</view>
    <view class="type-grid">
      <view
        wx:for="{{merchantTypes}}"
        wx:key="value"
        class="type-card {{merchantTypeIndex === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="selectMerchantType"
      >
        <view class="strong">{{item.label}}</view>
        <view class="muted">{{item.licenseLabel}}</view>
      </view>
    </view>

    <view class="form card">
      <view class="field"><text class="field-label">店铺名称</text><input class="input" value="{{name}}" data-field="name" bindinput="setField" placeholder="请输入营业执照上的名称" /></view>
      <view class="field"><text class="field-label">经营者姓名</text><input class="input" value="{{ownerName}}" data-field="ownerName" bindinput="setField" placeholder="请输入真实姓名" /></view>
      <view class="field"><text class="field-label">联系电话</text><input class="input" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="setField" placeholder="用于审核联系" /></view>

      <view wx:if="{{merchantTypes[merchantTypeIndex].value === 'PERSONAL'}}" class="identity card">
        <view class="identity-head">
          <view>
            <view class="strong">模拟实名验证</view>
            <view class="muted">当前为演示环境，不调用公安或运营商实名接口。</view>
          </view>
          <text wx:if="{{identityVerification}}" class="verified">已验证</text>
        </view>
        <view class="field"><text class="field-label">身份证号</text><input class="input" value="{{idNumber}}" data-field="idNumber" bindinput="setField" maxlength="18" placeholder="请输入18位身份证号" /></view>
        <button class="primary-button" size="mini" loading="{{verifyingIdentity}}" bindtap="verifyIdentity">{{identityVerification ? '重新验证' : '开始验证'}}</button>
        <view wx:if="{{identityVerification}}" class="identity-result muted">
          验证通过：{{identityVerification.ownerNameMasked}} · {{identityVerification.idNumberMasked}}
        </view>
      </view>
      <view wx:if="{{merchantTypes[merchantTypeIndex].value !== 'PERSONAL'}}" class="field">
        <text class="field-label">营业执照编号</text>
        <input class="input" value="{{licenseNo}}" data-field="licenseNo" bindinput="setField" placeholder="统一社会信用代码或执照编号" />
      </view>
      <view class="field"><text class="field-label">经营类目</text>
        <picker range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="setCategory">
          <view class="input">{{categoryIndex >= 0 ? categories[categoryIndex].label : '请选择经营类目'}} ▾</view>
        </picker>
      </view>
      <view wx:if="{{categoryIndex >= 0}}" class="tip muted">{{categories[categoryIndex].extra}}</view>
      <view class="field"><text class="field-label">服务区域</text><input class="input" value="{{serviceArea}}" data-field="serviceArea" bindinput="setField" placeholder="例如：狮山校区 / 荟园片区" /></view>
      <view class="field"><text class="field-label">店铺简介</text><textarea class="input textarea" value="{{description}}" data-field="description" bindinput="setField" placeholder="请填写主营业务、门店位置、服务范围" maxlength="300" /></view>

      <view wx:if="{{merchantTypes[merchantTypeIndex].value !== 'PERSONAL'}}" class="upload card">
        <view class="upload-head"><text class="field-label">营业执照照片</text><button size="mini" class="ghost-button" bindtap="chooseLicense">上传</button></view>
        <view class="muted">
          {{licenseFile ? (licenseFile.uploading ? '正在上传营业执照照片…' : '执照照片已上传，平台可在审核时查看。') : '请拍摄或从相册选择执照正面，画面需完整清晰。'}}
        </view>
      </view>

      <view class="agreements">
        <checkbox-group bindchange="setAgreement"><label class="agreement"><checkbox value="yes" checked="{{agreeAgreement}}" />已阅读并同意《商家入驻协议》</label></checkbox-group>
        <checkbox-group bindchange="setPrivacy"><label class="agreement"><checkbox value="yes" checked="{{agreePrivacy}}" />已阅读并同意《小程序隐私保护指引》</label></checkbox-group>
      </view>
    </view>
    <button class="primary-button" loading="{{submitting}}" bindtap="submit">提交入驻申请</button>
  </block>
</view>
