<view class="page">
  <view wx:if="{{loading}}" class="empty card"><view class="muted">正在同步商家数据…</view></view>
  <block wx:elif="{{merchant}}">
    <view class="merchant card">
      <view><view class="merchant-name">{{merchant.name}}</view><view class="muted">{{merchant.ownerNameMasked}} · {{merchant.phoneMasked}}</view></view>
      <view class="status">已入驻</view>
    </view>
    <view class="workbench card">
      <view class="workbench-head">
        <view>
          <view class="strong">经营看板</view>
          <view class="muted">先处理待履约和售后，再补货与复盘</view>
        </view>
        <button size="mini" class="ghost-button" bindtap="refreshWorkbench">刷新</button>
      </view>
      <view class="workbench-metrics">
        <view class="workbench-metric"><text>已支付营收（元）</text><strong>{{metrics.revenueInCents / 100}}</strong></view>
        <view class="workbench-metric"><text>订单</text><strong>{{metrics.orderCount}}</strong></view>
      </view>
      <view class="workbench-alerts">
        <view class="workbench-alert {{metrics.pendingCount ? 'attention' : ''}}" bindtap="goOrders"><text>待履约</text><strong>{{metrics.pendingCount}}</strong></view>
        <view class="workbench-alert {{metrics.afterSaleCount ? 'attention' : ''}}" bindtap="goAfterSales"><text>处理中售后</text><strong>{{metrics.afterSaleCount || 0}}</strong></view>
        <view class="workbench-alert {{metrics.lowStockCount ? 'attention' : ''}}" bindtap="goProducts"><text>库存偏低</text><strong>{{metrics.lowStockCount}}</strong></view>
        <view class="workbench-alert {{metrics.pendingReplyCount ? 'attention' : ''}}" bindtap="goReviews"><text>待回评</text><strong>{{metrics.pendingReplyCount || 0}}</strong></view>
      </view>
      <view class="quick-grid">
        <view class="quick-action" bindtap="goOrders"><view class="quick-icon">订单</view><view class="strong">订单管理</view><text>处理 / 售后</text></view>
        <view class="quick-action" bindtap="goProducts"><view class="quick-icon">商品</view><view class="strong">商品管理</view><text>上新 / 补货</text></view>
        <view class="quick-action" bindtap="goReviews"><view class="quick-icon">评价</view><view class="strong">评价管理</view><text>回复 / 复盘</text></view>
        <view class="quick-action" bindtap="openQualificationPanel"><view class="quick-icon">资质</view><view class="strong">资质更新</view><text>{{merchant.licenseExpireDate || '未登记'}}</text></view>
        <view class="quick-action" bindtap="goFinance"><view class="quick-icon">资金</view><view class="strong">资金账户</view><text>可结算 / 提现</text></view>
        <view class="quick-action" bindtap="openNoticeCenter"><view class="quick-icon">提醒</view><view class="strong">{{scoreNoticeSubscribed ? '提醒已开' : '开启提醒'}}</view><text>风险不遗漏</text></view>
      </view>
      <view class="workbench-tabs">
        <view class="workbench-tab {{activeWorkbenchTab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="setWorkbenchTab">
          <view class="tab-main">经营<text wx:if="{{workbenchCounts.overview}}" class="tab-badge {{activeWorkbenchTab === 'overview' ? '' : 'alert'}}">{{workbenchCounts.overview}}</text></view>
        </view>
        <view class="workbench-tab {{activeWorkbenchTab === 'risk' ? 'active' : ''}}" data-tab="risk" bindtap="setWorkbenchTab">
          <view class="tab-main">风险<text wx:if="{{workbenchCounts.risk}}" class="tab-badge {{activeWorkbenchTab === 'risk' ? '' : 'alert'}}">{{workbenchCounts.risk}}</text></view>
        </view>
        <view class="workbench-tab {{activeWorkbenchTab === 'finance' ? 'active' : ''}}" data-tab="finance" bindtap="setWorkbenchTab">
          <view class="tab-main">资金<text wx:if="{{workbenchCounts.finance}}" class="tab-badge {{activeWorkbenchTab === 'finance' ? '' : 'alert'}}">{{workbenchCounts.finance}}</text></view>
        </view>
        <view class="workbench-tab {{activeWorkbenchTab === 'messages' ? 'active' : ''}}" data-tab="messages" bindtap="setWorkbenchTab">
          <view class="tab-main">消息<text wx:if="{{workbenchCounts.messages}}" class="tab-badge {{activeWorkbenchTab === 'messages' ? '' : 'alert'}}">{{workbenchCounts.messages}}</text></view>
        </view>
      </view>
    </view>
    <view id="merchant-qualification-card" class="score card" wx:if="{{showQualificationPanel && activeWorkbenchTab === 'overview'}}">
      <view class="score-head">
        <view>
          <view class="strong">资质管理</view>
          <view class="muted">资质有效期 {{merchant.licenseExpireDate || '未登记'}} · 到期前 30 天平台会巡检提醒</view>
        </view>
        <button size="mini" class="ghost-button" bindtap="toggleQualificationPanel">收起</button>
      </view>
      <view class="evidence-block">
        <view class="evidence-head">
          <view class="muted">提交新执照复审</view>
          <button size="mini" class="ghost-button" disabled="{{uploadingRenewalEvidence}}" bindtap="chooseQualificationImage">{{uploadingRenewalEvidence ? '上传中' : '上传执照'}}</button>
        </view>
        <view class="field">
          <text class="field-label">营业执照编号</text>
          <input class="input" value="{{renewalLicenseNo}}" bindinput="setRenewalLicenseNo" placeholder="统一社会信用代码或执照编号" />
        </view>
        <view class="field">
          <text class="field-label">新执照有效期</text>
          <picker mode="date" value="{{renewalLicenseExpireDate}}" bindchange="setRenewalLicenseExpireDate">
            <view class="input">{{renewalLicenseExpireDate || '请选择有效期'}} ▾</view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">补充说明</text>
          <textarea class="input textarea" value="{{renewalNote}}" bindinput="setRenewalNote" maxlength="300" placeholder="说明换证原因或经营变化"></textarea>
        </view>
        <view class="evidence-grid" wx:if="{{renewalEvidence.length}}">
          <view class="evidence-item">
            <image src="{{renewalEvidence[0]}}" mode="aspectFill" bindtap="previewQualificationImage" />
          </view>
        </view>
        <button class="primary-button" loading="{{renewalSubmitting}}" bindtap="submitQualificationRenewal">提交资质复审</button>
      </view>
      <view class="score-case" wx:for="{{qualificationRenewals}}" wx:key="id">
        <view class="score-case-head">
          <view class="strong">复审申请 · {{item.licenseExpireDate}}</view>
          <text class="status-text tone-{{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
        <view class="muted">{{item.reviewText}}</view>
        <view class="muted notice-time">{{item.timeText}}</view>
      </view>
    </view>
    <block wx:if="{{activeWorkbenchTab === 'risk'}}">
    <view class="risk-urge-banner" wx:if="{{latestRiskUrge}}">
      <view class="risk-urge-title">平台已催办</view>
      <view class="risk-urge-content">{{latestRiskUrge.note}}</view>
      <view class="risk-urge-meta">{{latestRiskUrge.operator}} · {{latestRiskUrge.timeText}}</view>
    </view>
    <view id="merchant-score-card" class="score card" wx:if="{{serviceScore}}">
      <view class="score-head">
        <view>
          <view class="strong">店铺服务分</view>
          <view class="muted">按时交付 {{serviceScore.onTimeRateText}} · 已购评价 {{serviceScore.metrics.reviewCount}} 条</view>
        </view>
        <view class="score-value">
          <text class="score-number">{{serviceScore.score}}</text>
          <text class="status-text tone-{{serviceScore.stageTone}}">{{serviceScore.stageLabel}}</text>
        </view>
      </view>
      <view class="score-bars">
        <view class="score-bar" wx:for="{{serviceScore.breakdown}}" wx:key="key">
          <view class="score-bar-head"><text>{{item.label}}</text><text class="tone-{{item.toneClass}}">{{item.score}}</text></view>
          <view class="score-track"><view class="score-fill tone-{{item.toneClass}}" style="width:{{item.score}}%"></view></view>
          <view class="muted score-detail">{{item.detail}}</view>
        </view>
      </view>
      <view class="trend-block" wx:if="{{scoreTrend}}">
        <view class="trend-head">
          <view class="strong trend-title">14 天服务分趋势</view>
          <text class="status-text tone-{{scoreTrend.changeTone}}">{{scoreTrend.changeText}}</text>
        </view>
        <view class="trend-chart">
          <view class="trend-bar tone-{{item.stageTone}}" wx:for="{{scoreTrend.points}}" wx:key="date" style="height:{{item.heightPercent}}%">
            <view class="trend-tip">{{item.score}}</view>
          </view>
        </view>
        <view class="trend-scale">
          <text>{{scoreTrend.points[0].label}}</text>
          <text>{{scoreTrend.points[scoreTrend.points.length - 1].label}}</text>
        </view>
        <view class="trend-effect" wx:if="{{scoreTrend.effect}}">
          <view class="trend-effect-label">整改效果</view>
          <view class="muted">{{scoreTrend.effect.effectText}}</view>
        </view>
        <view class="trend-risk" wx:if="{{scoreTrend.risk}}">
          <view class="trend-risk-label">扣分风险</view>
          <view class="muted">{{scoreTrend.risk.riskText}}</view>
        </view>
      </view>
      <view class="muted score-note">{{serviceScore.consequenceText}}</view>
      <view class="muted score-note" wx:if="{{serviceScore.complianceText}}">{{serviceScore.complianceText}}</view>
      <view class="muted score-note" wx:if="{{serviceScore.weakestText}}">最需要改进：{{serviceScore.weakestText}}</view>
      <view class="risk-task-block" wx:if="{{riskTasks.length}}">
        <view class="risk-task-head">
          <view class="strong">风险处理清单</view>
          <view class="muted">按影响优先处理</view>
        </view>
        <view class="risk-task" wx:for="{{riskTasks}}" wx:key="id" bindtap="goRiskTask" data-type="{{item.type}}" data-id="{{item.reference}}">
          <view class="risk-task-main">
            <view class="risk-task-title">{{item.title}}</view>
            <view class="muted risk-task-detail">{{item.detail}}</view>
            <view class="risk-task-urge" wx:if="{{item.urgeText}}">{{item.urgeText}}</view>
            <view class="muted risk-task-due" wx:if="{{item.dueText}}">处理时限 <text class="status-text tone-{{item.dueTone}}">{{item.dueText}}</text></view>
          </view>
          <view class="risk-task-action">{{item.action}}</view>
        </view>
      </view>
      <picker wx:if="{{scoreCaseType === 'RECTIFY' && delistedProducts.length}}" range="{{delistedProducts}}" range-key="name" value="{{rectifyProductIndex}}" bindchange="setRectifyProduct">
        <view class="appeal-picker">整改商品：{{delistedProducts[rectifyProductIndex].name}}</view>
      </picker>
      <view class="score-actions">
        <picker wx:if="{{scoreCaseType === 'APPEAL'}}" range="{{appealReasons}}" range-key="label" value="{{scoreCaseReasonTypeIndex}}" bindchange="setAppealReason">
          <view class="appeal-picker">{{appealReasons[scoreCaseReasonTypeIndex].label}} ▾</view>
        </picker>
        <button size="mini" class="{{scoreCaseType === 'APPEAL' ? 'primary-button' : 'ghost-button'}}" data-type="APPEAL" bindtap="openScoreCase">提交申诉</button>
        <button size="mini" class="{{scoreCaseType === 'RECTIFY' ? 'primary-button' : 'ghost-button'}}" data-type="RECTIFY" bindtap="openScoreCase">提交整改</button>
        <button size="mini" class="ghost-button" bindtap="subscribeScoreNotice">{{scoreNoticeSubscribed ? '提醒已开启' : '开启提醒'}}</button>
      </view>
      <view class="evidence-block">
        <view class="evidence-head">
          <view class="muted">凭证材料（最多 6 张）</view>
          <button size="mini" class="ghost-button" disabled="{{uploadingScoreEvidence}}" bindtap="chooseScoreEvidence">{{uploadingScoreEvidence ? '上传中' : '添加凭证'}}</button>
        </view>
        <view class="evidence-grid" wx:if="{{scoreEvidence.length}}">
          <view class="evidence-item" wx:for="{{scoreEvidence}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill" bindtap="previewScoreEvidence" data-url="{{item}}" />
            <view class="evidence-remove" data-url="{{item}}" catchtap="removeScoreEvidence">×</view>
          </view>
        </view>
      </view>
      <view id="merchant-score-case-{{item.id}}" class="score-case {{item.id === focusId ? 'focus-item' : ''}}" wx:for="{{scoreCases}}" wx:key="id">
        <view class="score-case-head">
          <view class="strong">{{item.caseNo}} · {{item.typeLabel}}</view>
          <text class="status-text tone-{{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
        <view class="muted">{{item.reasonTypeLabel || item.typeLabel}}：{{item.reason}}</view>
        <view class="muted" wx:if="{{item.countdownText}}">复核时限：<text class="status-text tone-{{item.countdownTone}}">{{item.countdownText}}</text></view>
        <view class="evidence-grid" wx:if="{{item.evidence.length}}">
          <image wx:for="{{item.evidence}}" wx:for-item="evidence" wx:key="*this" src="{{evidence}}" mode="aspectFill" bindtap="previewScoreEvidence" data-url="{{evidence}}" />
        </view>
        <view class="muted" wx:if="{{item.resultText}}">{{item.resultText}} · {{item.adminNote}}</view>
        <view class="muted notice-time">{{item.timeText}}</view>
      </view>
    </view>
    <view class="score card" wx:if="{{watchingProducts.length}}">
      <view class="notice-head"><view class="strong">人工复核观察期</view><text class="muted">{{watchingProducts.length}} 件已恢复</text></view>
      <view id="merchant-watch-{{item.id}}" class="sla-item {{item.id === focusId ? 'focus-item' : ''}}" wx:for="{{watchingProducts}}" wx:key="id">
        <view class="sla-main">
          <view class="strong">{{item.name}}</view>
          <view class="muted">{{item.autoDelistReason || item.evidenceText}}</view>
          <view class="muted" wx:if="{{item.autoDelistReviewNote}}">{{item.autoDelistReviewNote}}</view>
          <view class="muted" wx:if="{{item.watchText}}">观察期：<text class="status-text tone-{{item.watchTone}}">{{item.watchText}}</text></view>
        </view>
      </view>
      <view class="muted sla-note">观察期内再次触发风控将自动下架；7 天后恢复正常展示。</view>
    </view>
    <view class="score card" wx:if="{{delistedProducts.length}}">
      <view class="notice-head"><view class="strong">商品自动下架</view><text class="muted">{{delistedProducts.length}} 件待整改</text></view>
      <view id="merchant-delist-{{item.id}}" class="sla-item {{item.id === focusId ? 'focus-item' : ''}}" wx:for="{{delistedProducts}}" wx:key="id">
        <view class="sla-main">
          <view class="strong">{{item.name}}<text class="status-text tone-blue risk-status">{{item.statusText}}</text></view>
          <view class="muted">{{item.autoDelistReason}} · {{item.evidenceText}}</view>
          <view class="muted" wx:if="{{item.complianceCase && item.complianceCase.caseNo}}">工单 {{item.complianceCase.caseNo}}{{item.complianceCase.adminNote ? ' · ' + item.complianceCase.adminNote : ''}}</view>
          <view class="muted" wx:if="{{item.countdownText}}">复核时限：<text class="status-text tone-{{item.countdownTone}}">{{item.countdownText}}</text></view>
          <view class="muted" wx:if="{{item.watchText}}">观察期：<text class="status-text tone-{{item.watchTone}}">{{item.watchText}}</text></view>
          <view class="muted sla-note">{{item.nextActionText}}</view>
        </view>
        <button size="mini" class="ghost-button" data-type="RECTIFY" data-product-index="{{index}}" bindtap="setScoreCaseType" disabled="{{item.complianceCase && (item.complianceCase.status === 'SUBMITTED' || item.complianceCase.status === 'REVIEWING')}}">{{item.canResubmit ? '重新整改' : (item.complianceCase && (item.complianceCase.status === 'SUBMITTED' || item.complianceCase.status === 'REVIEWING') ? '审核中' : '提交整改')}}</button>
      </view>
      <view class="muted sla-note">整改验收通过后商品自动恢复；未通过可补充凭证后重新提交。</view>
    </view>
    <view class="score card" wx:if="{{pendingPublishProducts.length}}">
      <view class="notice-head"><view class="strong">待平台复核商品</view><text class="muted">{{pendingPublishProducts.length}} 件</text></view>
      <view class="sla-item" wx:for="{{pendingPublishProducts}}" wx:key="id">
        <view class="sla-main">
          <view class="strong">{{item.name}}</view>
          <view class="muted">{{item.publishReviewNote}}</view>
        </view>
      </view>
    </view>
    <view class="sla card" wx:if="{{slaAlerts.length}}">
      <view class="notice-head"><view class="strong">履约提醒</view><text class="muted">待处理 {{metrics.slaOpenCount || 0}} · 已超时 {{metrics.slaOverdueCount || 0}}</text></view>
      <view class="sla-item" wx:for="{{slaAlerts}}" wx:key="id">
        <view class="sla-main">
          <view class="strong">{{item.ruleLabel}} · {{item.businessNo}}</view>
          <view class="muted">{{item.detail}}</view>
          <view class="muted" wx:if="{{item.ackText}}">{{item.ackText}}</view>
        </view>
        <view class="right"><view class="status-text tone-{{item.levelTone}}">{{item.levelLabel}}</view><view class="muted">{{item.countdownText}}</view></view>
      </view>
      <view class="muted sla-note">超时会影响店铺履约评分，请优先处理已超时事项</view>
    </view>
    </block>
    <block wx:if="{{activeWorkbenchTab === 'messages'}}">
    <view class="notification card" wx:if="{{notifications.length}}">
      <view class="notice-head"><view class="strong">商家提醒</view><text class="muted">未读 {{unreadNotificationCount}}</text></view>
      <view class="notice-item {{item.link ? 'notice-action' : ''}}" wx:for="{{notifications}}" wx:key="id" bindtap="openNotification" data-link="{{item.link}}">
        <view class="strong">{{item.title}}</view>
        <view class="muted">{{item.content}}</view>
        <view class="muted notice-time">{{item.timeText}}<text wx:if="{{item.link}}" class="notice-link">查看详情</text></view>
      </view>
    </view>
    <view wx:if="{{!notifications.length}}" class="empty card"><view class="muted">暂无商家提醒</view></view>
    </block>
    <block wx:if="{{activeWorkbenchTab === 'overview'}}">
    <view class="sla card" wx:if="{{promotionSummary.length}}">
      <view class="notice-head"><view class="strong">促销成效</view><text class="muted">{{promotionSummary.length}} 个活动</text></view>
      <view class="sla-item" wx:for="{{promotionSummary}}" wx:key="id">
        <view class="sla-main">
          <view class="strong">{{item.name}}<text class="status-text tone-blue">{{item.campaignStatusLabel}}</text></view>
          <view class="muted">实付成交 ¥{{item.campaignAmountText}} · 让利 ¥{{item.campaignDiscountText}} · 已付 {{item.campaignPaidOrderCount}} 单 / {{item.campaignSalesQuantity}} 件</view>
        </view>
        <button size="mini" class="ghost-button" bindtap="goProducts">调整</button>
      </view>
      <view class="muted sla-note">统计口径为已支付电瓶车和电话卡订单，投放期外保留历史成交复盘。</view>
    </view>
    <view class="sla card" wx:if="{{lowStockProducts.length}}">
      <view class="notice-head"><view class="strong">库存偏低</view><text class="muted">阈值 {{lowStockThreshold}} 件</text></view>
      <view class="sla-item" wx:for="{{lowStockProducts}}" wx:key="id">
        <view class="sla-main">
          <view class="strong">{{item.name}}</view>
          <view class="muted">可售 {{item.availableStock}} 件{{item.reservedStock ? ' · 待支付占用 ' + item.reservedStock + ' 件' : ''}} · {{item.favoriteDemandText}}</view>
        </view>
        <button size="mini" class="ghost-button" bindtap="goProducts">去补货</button>
      </view>
    </view>
    </block>
    <block wx:if="{{activeWorkbenchTab === 'finance'}}">
    <view class="section-title">资金账户</view>
    <view id="merchant-payout-card" class="settle-panel card">
      <view class="settle-head">
        <view><view class="strong">可结算余额</view><view class="muted">服务费率 {{metrics.settlementMetrics.commissionRatePercent}}% · 账期 {{metrics.settlementMetrics.settlementPeriodDays}} 天</view></view>
        <view class="settle-amount">¥{{metrics.settlementMetrics.payableInCents / 100}}</view>
      </view>
      <view class="settle-flow">
        <view class="flow-step"><text class="flow-index">1</text><text class="flow-text">支付成功</text></view>
        <text class="flow-arrow">›</text>
        <view class="flow-step"><text class="flow-index">2</text><text class="flow-text">交付核验</text></view>
        <text class="flow-arrow">›</text>
        <view class="flow-step"><text class="flow-index">3</text><text class="flow-text">账期 {{metrics.settlementMetrics.settlementPeriodDays}} 天</text></view>
        <text class="flow-arrow">›</text>
        <view class="flow-step"><text class="flow-index">4</text><text class="flow-text">平台打款</text></view>
      </view>
      <view class="settle-cells">
        <view class="settle-cell"><text>待交付核验</text><strong>¥{{metrics.settlementMetrics.pendingDeliveryInCents / 100}}</strong></view>
        <view class="settle-cell"><text>账期中</text><strong>¥{{metrics.settlementMetrics.inAccountPeriodInCents / 100}}</strong></view>
        <view class="settle-cell" wx:if="{{metrics.settlementMetrics.payoutRequestedInCents}}"><text>提现待审核</text><strong>¥{{metrics.settlementMetrics.payoutRequestedInCents / 100}}</strong></view>
        <view class="settle-cell"><text>已结算</text><strong>¥{{metrics.settlementMetrics.settledInCents / 100}}</strong></view>
        <view class="settle-cell" wx:if="{{metrics.settlementMetrics.frozenInCents}}"><text>售后冻结</text><strong class="warn">¥{{metrics.settlementMetrics.frozenInCents / 100}}</strong></view>
        <view class="settle-cell" wx:if="{{metrics.settlementMetrics.refundedInCents}}"><text>已冲销</text><strong class="warn">¥{{metrics.settlementMetrics.refundedInCents / 100}}</strong></view>
      </view>
      <view class="payout-action">
        <view class="payout-hint">{{payoutHint}}</view>
        <button class="payout-button {{canRequestPayout ? '' : 'disabled'}}" disabled="{{!canRequestPayout || payoutSubmitting}}" bindtap="requestPayout">申请提现</button>
      </view>
      <view class="muted payout-note">起提金额 ¥{{payoutMinimumText}}，提交后由平台核对收款账户并打款</view>
    </view>
    <block wx:if="{{payoutRequests.length}}">
      <view class="section-title">提现记录</view>
      <view class="card order" wx:for="{{payoutRequests}}" wx:key="id">
        <view class="settle-main"><view class="strong">{{item.requestNo}}</view><view class="muted">{{item.createdText}} · {{item.settlementCount}} 笔分账</view><view class="muted stage-hint">{{item.noteText}}</view></view>
        <view class="right"><view class="price">¥{{item.amountText}}</view><view class="status-text tone-{{item.statusTone}}">{{item.statusLabel}}</view></view>
      </view>
    </block>
    <view class="section-title">对账单</view>
    <view class="card order">
      <view class="settle-main">
        <view class="strong">{{statementMonth}} 资金对账</view>
        <view class="muted" wx:if="{{statement}}">收入 ¥{{statement.totals.businessGrossInCents / 100}} · 佣金 ¥{{statement.totals.commissionInCents / 100}}</view>
        <view class="muted" wx:if="{{statement}}">本月应收 ¥{{statement.totals.businessPayableInCents / 100}} · 已冲销 ¥{{statement.totals.refundInCents / 100}}</view>
        <view class="muted" wx:if="{{statement}}">净应收 ¥{{statement.totals.netInCents / 100}} · 已提现 ¥{{statement.totals.payoutPaidInCents / 100}}</view>
      </view>
      <view class="right">
        <picker mode="date" fields="month" value="{{statementMonth}}" bindchange="setStatementMonth">
          <button size="mini" class="ghost-button">选月份</button>
        </picker>
        <button size="mini" class="ghost-button" disabled="{{!statement || statementSaving}}" bindtap="saveStatement">导出文件</button>
      </view>
    </view>
    <view wx:if="{{!statement}}" class="empty card"><view class="muted">暂无本月对账数据</view></view>
    </block>
    <block wx:if="{{activeWorkbenchTab === 'overview'}}">
    <view class="section-title">最近订单</view>
    <view class="card order workbench-order" wx:for="{{orders}}" wx:key="id" bindtap="goWorkbenchOrder" data-id="{{item.id}}" data-status="{{item.status}}">
      <view><view class="strong">{{item.orderNo}}</view><view class="muted">{{item.items[0].name}}{{item.items.length > 1 ? ' 等' : ''}}</view></view>
      <view class="right"><view class="price">¥{{item.totalInCents / 100}}</view><view class="muted status-text">{{item.statusLabel}}</view><view class="order-link">去处理</view></view>
    </view>
    <view wx:if="{{!orders.length}}" class="empty card"><view class="muted">暂无商家订单</view></view>
    <view class="section-title">最近分账</view>
    <view class="card order" wx:for="{{settlements}}" wx:key="id">
      <view class="settle-main"><view class="strong">{{item.orderNo}}</view><view class="muted">费率 {{item.commissionRatePercent}}% · 服务费 ¥{{item.platformFeeInCents / 100}}</view><view class="muted stage-hint">{{item.stageHint}}</view></view>
      <view class="right"><view class="price">¥{{item.payableAmountInCents / 100}}</view><view class="status-text tone-{{item.stageTone}}">{{item.stageLabel}}</view></view>
    </view>
    <view wx:if="{{!settlements.length}}" class="empty card"><view class="muted">支付成功后生成分账记录</view></view>
    </block>
  </block>
</view>
