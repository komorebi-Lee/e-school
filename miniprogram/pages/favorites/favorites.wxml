<view class="page favorites-page">
  <!-- 失败占位：接口挂了必须说出来，并且能重试。旧列表（若有）仍显示在下方。 -->
  <view wx:if="{{favoritesBlock.error}}" class="load-error card">
    <view class="muted">{{favoritesBlock.error}}</view>
    <button size="mini" class="ghost-button" bindtap="retryFavorites">重试</button>
  </view>

  <view class="loading muted" wx:if="{{favoritesBlock.loading && !favoritesBlock.data.length}}">正在同步收藏…</view>
  <view wx:elif="{{saleCount}}" class="sale-banner card">
    <view class="sale-copy"><text class="sale-title">收藏好价进行中</text><text class="muted">{{saleCount}} 件商品正在限时降价</text></view>
    <text class="sale-action">去抢购</text>
  </view>
  <!-- 空态：必须同时「不在加载」且「没有错误」，否则失败会被说成「还没有收藏」 -->
  <view wx:elif="{{!favoritesBlock.data.length && !favoritesBlock.error}}" class="empty card">
    <view class="empty-icon">藏</view>
    <view class="empty-title">还没有收藏车型</view>
    <view class="muted">在商品详情点收藏，方便比价和到货后回看。</view>
  </view>
  <block wx:else>
    <view class="product card" wx:for="{{favoritesBlock.data}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="visual" style="background: {{item.color}}">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
        <text wx:else>{{item.icon}}</text>
      </view>
      <view class="body">
        <view class="name">{{item.name}}</view>
        <view class="muted subtitle">{{item.description}}</view>
        <view class="meta"><text>{{item.merchantName}}</text><text>{{item.stockText}}</text><text>{{item.salesText}}</text></view>
        <view class="bottom">
          <text class="rating">{{item.ratingText}}</text>
          <view class="fav-remove" catchtap="cancelFavorite" data-id="{{item.id}}">取消收藏</view>
          <view class="price-group"><text wx:if="{{item.originalPrice}}" class="original-price">¥{{item.originalPrice}}</text><text class="price">¥{{item.price}}</text></view>
        </view>
        <view wx:if="{{item.promoText}}" class="promo-row"><text class="promo-badge">{{item.promoText}}</text></view>
      </view>
    </view>
  </block>
</view>
