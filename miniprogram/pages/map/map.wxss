.page { position: relative; height: 100vh; background: #f5f7fb; }
.campus-map { width: 100%; height: 100%; }
.top-layer { position: absolute; top: 24rpx; right: 24rpx; left: 24rpx; z-index: 2; }
.search-bar { display: flex; align-items: center; padding: 10rpx 20rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .96); box-shadow: 0 10rpx 26rpx rgba(0, 47, 167, .12); }
.search-input { flex: 1; height: 62rpx; font-size: 24rpx; color: #172033; }
.chips { margin-top: 18rpx; white-space: nowrap; }
.chip { display: inline-block; margin-right: 12rpx; padding: 12rpx 20rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .94); color: #536078; font-size: 21rpx; font-weight: 800; box-shadow: 0 6rpx 16rpx rgba(0, 47, 167, .08); }
.chip-active { background: #2f7a3e; color: #fff; }
.locate-fail { position: absolute; top: 210rpx; left: 50%; transform: translateX(-50%); z-index: 2; padding: 12rpx 20rpx; border-radius: 999rpx; background: #fff7ed; color: #9a5b10; font-size: 21rpx; font-weight: 800; box-shadow: 0 8rpx 20rpx rgba(0, 47, 167, .1); }
.panel { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 3; display: flex; align-items: flex-end; background: rgba(23, 32, 51, .36); }
.panel-card { width: 100%; box-sizing: border-box; padding: 22rpx 26rpx 30rpx; border-radius: 34rpx 34rpx 0 0; background: #fff; }
.panel-img { width: 100%; margin-bottom: 18rpx; border-radius: 22rpx; }
.panel-img--sticker { height: 190rpx; padding: 12rpx; box-sizing: border-box; background: #f7fbf5; }
.panel-img-hint { display: block; margin: -10rpx 0 14rpx; color: #9aa8bf; font-size: 19rpx; }
.panel-head { display: flex; align-items: center; justify-content: space-between; }
.panel-name { font-size: 32rpx; font-weight: 900; color: #172033; }
.panel-cat { padding: 7rpx 14rpx; border-radius: 999rpx; background: #eaf7ea; color: #2f7a3e; font-size: 19rpx; font-weight: 900; }
.panel-desc { display: block; margin-top: 16rpx; color: #536078; font-size: 22rpx; line-height: 1.6; }
.panel-addr { display: block; margin-top: 10rpx; color: #78849a; font-size: 20rpx; }
.panel-route { display: flex; align-items: center; margin-top: 16rpx; padding: 14rpx 18rpx; border-radius: 18rpx; background: #eef4ff; }
.panel-route-label { margin-right: 12rpx; color: #002fa7; font-size: 20rpx; font-weight: 900; }
.panel-route-text { color: #33456b; font-size: 21rpx; font-weight: 700; }
.panel-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; }
.panel-distance { color: #002fa7; font-size: 22rpx; font-weight: 900; }
.panel-actions { display: flex; align-items: center; }
.panel-actions .nav-btn { margin-left: 12rpx; }
.nav-btn { margin: 0; background: #002fa7; color: #fff; border-radius: 999rpx; font-weight: 900; }
.nav-btn--ghost { background: #eef4ff; color: #002fa7; }
