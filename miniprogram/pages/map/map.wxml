<view class="page">
  <map
    class="campus-map"
    id="campusMap"
    latitude="{{center.latitude}}"
    longitude="{{center.longitude}}"
    scale="{{scale}}"
    min-scale="14"
    max-scale="19"
    markers="{{markers}}"
    show-location
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
  ></map>

  <view class="top-layer">
    <view class="search-bar">
      <input class="search-input" placeholder="搜索建筑、食堂、专业楼…" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" />
    </view>
    <scroll-view class="chips" scroll-x enable-flex>
      <view wx:for="{{categories}}" wx:key="*this" class="chip {{activeCategory === item ? 'chip-active' : ''}}" bindtap="onCategory" data-cat="{{item}}">{{item}}</view>
    </scroll-view>
  </view>

  <view class="locate-fail" wx:if="{{locateFailed}}" bindtap="onRetryLocate">📍 未授权定位，点此重试</view>

  <view class="panel" wx:if="{{selected}}" bindtap="closePanel">
    <view class="panel-card" catchtap="noop">
      <image wx:if="{{selected.image}}" src="{{selected.image}}" mode="{{selected.imageMode}}" class="panel-img {{selected.imageMode === 'aspectFit' ? 'panel-img--sticker' : ''}}" bindtap="toggleImageMode"></image>
      <text class="panel-img-hint" wx:if="{{selected.image}}" bindtap="toggleImageMode">点图切换 大图 / 贴纸</text>
      <view class="panel-head">
        <text class="panel-name">{{selected.name}}</text>
        <text class="panel-cat">{{selected.category}}</text>
      </view>
      <text class="panel-desc" wx:if="{{selected.desc}}">{{selected.desc}}</text>
      <text class="panel-addr" wx:if="{{selected.address}}">{{selected.address}}</text>
      <view class="panel-route" wx:if="{{route}}">
        <text class="panel-route-label">步行路线</text>
        <text class="panel-route-text">{{route.distanceText}} · {{route.durationText}}</text>
      </view>
      <view class="panel-foot">
        <text class="panel-distance" wx:if="{{selected.distance}}">距我 {{selected.distance}}</text>
        <view class="panel-actions">
          <button class="nav-btn nav-btn--ghost" size="mini" bindtap="openOfficialMap">官网地图</button>
          <button class="nav-btn" size="mini" bindtap="startRoute">步行路线</button>
          <button class="nav-btn" size="mini" catchtap="goNavigate">到这里去</button>
        </view>
      </view>
    </view>
  </view>
</view>
