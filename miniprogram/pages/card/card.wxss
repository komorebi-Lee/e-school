.official { background: #002fa7; color: #fff; padding: 32rpx; }.official-label { color: #ffd60a; font-size: 22rpx; font-weight: 800; }.official-title { font-size: 34rpx; font-weight: 900; margin: 16rpx 0; }.official-copy { color: #dce7ff; line-height: 1.7; font-size: 24rpx; }
.status-card { display: flex; align-items: center; padding: 26rpx; margin-top: 22rpx; }.status-dot { width: 22rpx; height: 22rpx; background: #24b47e; border-radius: 50%; margin-right: 22rpx; box-shadow: 0 0 0 12rpx #d9f7ea; }.status-title { font-size: 30rpx; font-weight: 800; margin: 8rpx 0; }
.plans { display: flex; flex-direction: column; gap: 18rpx; }.plan { padding: 25rpx; border: 3rpx solid transparent; }.plan.selected { border-color: #002fa7; background: #f7f9ff; }.plan-top,.plan-benefits { display: flex; align-items: center; justify-content: space-between; }.plan-name { font-size: 30rpx; font-weight: 900; }.plan-badge { display: inline-flex; margin-top: 8rpx; background: #eaf0ff; color: #002fa7; border-radius: 999rpx; padding: 6rpx 12rpx; font-size: 19rpx; }.plan-price { color: #002fa7; font-size: 38rpx; font-weight: 900; }.plan-benefits { background: #f4f6fb; border-radius: 14rpx; padding: 16rpx; margin-top: 20rpx; color: #536078; font-size: 22rpx; }
.form { padding: 28rpx; }.tips { margin-top: 26rpx; color: #667289; line-height: 1.9; font-size: 23rpx; }.tips-title { color: #172033; font-weight: 800; }
.promo-heading { display: flex; align-items: center; gap: 12rpx; }.limited { color: #fff; background: #ff5b4d; border-radius: 999rpx; padding: 5rpx 11rpx; font-size: 18rpx; }.recharge-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.recharge-card { padding: 23rpx; position: relative; overflow: hidden; }.recharge-badge { color: #ff5b4d; font-size: 19rpx; font-weight: 800; }.recharge-title { font-size: 28rpx; font-weight: 900; margin-top: 15rpx; }.recharge-value { color: #78849a; font-size: 20rpx; margin: 5rpx 0 18rpx; }.recharge-value text { color: #002fa7; font-size: 34rpx; font-weight: 900; }.recharge-button { background: #002fa7; color: #fff; border-radius: 12rpx; margin: 0; }.recharge-button::after { border: 0; }
.broadband { padding: 27rpx; }.broadband-top { display: flex; align-items: center; }.wifi { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; background: #002fa7; color: #fff; border-radius: 24rpx; font-size: 20rpx; font-weight: 900; margin-right: 20rpx; }.broadband-title { font-size: 29rpx; font-weight: 900; }.broadband-copy { font-size: 21rpx; line-height: 1.5; margin-top: 6rpx; }.broadband-status { background: #d9f7ea; color: #157552; padding: 15rpx; border-radius: 13rpx; font-size: 21rpx; margin-top: 20rpx; }.companion { margin-top: 23rpx; }
.official-copy{line-height:1.6}.form-tip{color:#536078;font-size:26rpx;margin-bottom:18rpx}.plan{padding:24rpx;margin-bottom:16rpx}.plan.selected{border:3rpx solid #002fa7}.plan-top{display:flex;justify-content:space-between;align-items:flex-start}.plan-name{font-size:30rpx;font-weight:800}.plan-price{color:#002fa7;font-size:38rpx;font-weight:900}.plan-benefits{display:flex;justify-content:space-between;background:#f5f7fb;padding:16rpx;margin-top:18rpx;color:#536078}.recharge-card{padding:22rpx}.recharge-button{background:#002fa7;color:#fff}
.business-tabs{display:flex;position:relative;background:#eef3ff;border-radius:12rpx;padding:4rpx;margin:0 0 18rpx;overflow:hidden}.sticky-tabs{position:sticky;top:0;z-index:20;box-shadow:0 8rpx 18rpx rgba(18,43,93,.10)}.business-tab{position:relative;z-index:2;flex:1;text-align:center;padding:16rpx 8rpx;color:#536078;border-radius:9rpx;font-size:24rpx;transition:color .22s}.business-tab.active{color:#fff;font-weight:700}.tab-indicator{position:absolute;z-index:1;top:4rpx;bottom:4rpx;left:4rpx;width:calc((100% - 8rpx)/3);border-radius:9rpx;background:#002fa7;transition:transform .26s ease}.tab-0{transform:translateX(0)}.tab-1{transform:translateX(100%)}.tab-2{transform:translateX(200%)}
.recharge-note { margin: 16rpx 4rpx 0; font-size: 21rpx; line-height: 1.55; }
