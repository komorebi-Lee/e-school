<view class="page home-page">
  <view class="campus-bar">
    <view><view class="brand">狮山智生活</view><view class="campus">华中农业大学 · 狮山校区</view></view>
    <view class="verified">校园服务</view>
  </view>
  <view class="hero"><view class="hero-kicker">买车 · 上牌 · 充电 · 通信</view><view class="hero-title">买车办卡，狮山一次办好</view><view class="hero-copy">电动车订单自动联办校园牌照；电话卡订单可推进实名、话费和宽带。</view></view>
  <view class="business-grid">
    <view class="business-card scooter-business" bindtap="goScooters"><view class="business-icon inverse">车</view><view class="business-name light">校园电动车</view><view class="business-slogan light-copy">校内配送 · 自动联办牌照</view><view class="business-price light">¥1899<text>起</text></view><view class="buy-button white">立即购车 ›</view></view>
    <view class="business-card phone-business" bindtap="goCard"><view class="business-icon">卡</view><view class="business-name">校园电话卡</view><view class="business-slogan">套餐 · 话费 · 宽带</view><view class="business-price">¥19<text>/月起</text></view><view class="buy-button blue">立即办卡 ›</view></view>
  </view>
  <view class="service-strip card"><view><text class="service-icon">24</text><text>24小时内联系</text></view><view><text class="service-icon">校</text><text>校内配送</text></view><view><text class="service-icon">专</text><text>专人跟进</text></view></view>
  <view class="section-title">你可以在这里办理</view>
  <view class="reason-grid"><view class="reason-card card" bindtap="goScooters"><view class="reason-title"><text class="reason-dot">车</text>电动车服务</view><view class="reason-item">选车型 · 直接支付</view><view class="reason-item">校内配送 · 牌照协助</view><view class="reason-item">充电资格查询</view></view><view class="reason-card card" bindtap="goCard"><view class="reason-title"><text class="reason-dot">卡</text>通信服务</view><view class="reason-item">校园套餐咨询</view><view class="reason-item">话费活动 · 宽带资格</view><view class="reason-item">实名办理指引</view></view></view>
  <view class="process card"><view class="process-title">办理流程</view><view class="process-steps"><view><text>1</text><label>选车/办卡</label></view><view class="process-line"></view><view><text>2</text><label>在线支付</label></view><view class="process-line"></view><view><text>3</text><label>校内履约</label></view></view></view>
  <view class="section-head"><view class="section-title compact">热门业务</view><view class="more" bindtap="goScooters">查看全部 ›</view></view>
  <view class="product-card card" wx:for="{{phonePlans}}" wx:key="name" bindtap="goCard"><view class="product-type phone-type">电话卡</view><view class="product-main"><view class="product-name">{{item.name}}</view><view class="muted product-desc">{{item.data}} · {{item.badge}}</view></view><view class="product-price">¥{{item.price}}<text>/月</text></view></view>
  <view class="product-card card" wx:for="{{scooters}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail"><view class="product-type scooter-type">电动车</view><view class="product-main"><view class="product-name">{{item.name}}</view><view class="muted product-desc">{{item.range}}续航 · 校内配送</view></view><view class="product-price">¥{{item.price}}</view></view>
  <view class="plate-banner card" bindtap="goPlate"><view class="plate-symbol">牌</view><view class="plate-content"><view class="plate-title">校园牌照辅助</view><view class="plate-copy">平台购车可申请免费协助，自带车辆人工确认报价</view></view><view class="plate-arrow">›</view></view>
  <view class="notice">服务范围及办理结果以学校及合作方最终确认为准</view>
</view>
