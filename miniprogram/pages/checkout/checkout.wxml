  <view wx:if="{{scooter}}" class="page">
  <view class="summary card"><view class="mark" style="background: {{scooter.color}}">{{scooter.icon}}</view><view><view class="name">{{scooter.name}}</view><view class="muted">{{scooter.subtitle}}</view><view class="price-line"><block wx:if="{{isRental}}"><text class="price">{{scooter.priceText}}</text><text wx:if="{{scooter.originalPriceText}}" class="original">{{scooter.originalPriceText}}</text></block><block wx:else><text class="price">¥{{scooter.price}}</text><text wx:if="{{scooter.originalPrice}}" class="original">¥{{scooter.originalPrice}}</text><text wx:if="{{scooter.promoText}}" class="promo">{{scooter.promoText}}</text></block></view><view class="muted small" wx:if="{{isRental && scooter.sellableStock < 5}}">{{scooter.sellableStock > 0 ? '仅剩 ' + scooter.sellableStock + ' 台可租' : '已租满'}}</view><view class="muted small" wx:if="{{!isRental && scooter.sellableStock < 5}}">{{scooter.sellableStock > 0 ? '仅剩 ' + scooter.sellableStock + ' 件' : '已售罄'}}</view></view></view>
  <view class="quantity-row card" wx:if="{{!scooter.stockNote && !isRental}}">
    <view><view class="quantity-title">购买数量</view><view class="muted small">每辆车同步免费校园牌照辅助 · 最多可买 {{maxQuantity}} 件</view></view>
    <view class="quantity-control">
      <view class="quantity-button {{quantity <= 1 ? 'disabled' : ''}}" data-action="decrease" bindtap="setQuantity">-</view>
      <view class="quantity-value">{{quantity}}</view>
      <view class="quantity-button {{quantity >= maxQuantity ? 'disabled' : ''}}" data-action="increase" bindtap="setQuantity">+</view>
    </view>
  </view>
  <view class="rental-row card" wx:if="{{isRental && !scooter.stockNote}}">
    <view><view class="quantity-title">租期选择</view><view class="muted small">按{{rentalUnitLabel}}计费 · 可租 {{rentalPlan.minUnits}}~{{rentalPlan.maxUnits}} {{rentalUnitLabel}} · 押金每单固定一份</view></view>
    <view class="quantity-control">
      <view class="quantity-button {{rentalUnits <= rentalPlan.minUnits ? 'disabled' : ''}}" data-action="decrease" bindtap="setRentalUnits">-</view>
      <view class="quantity-value">{{rentalUnits}}</view>
      <view class="quantity-button {{rentalUnits >= rentalPlan.maxUnits ? 'disabled' : ''}}" data-action="increase" bindtap="setRentalUnits">+</view>
    </view>
  </view>
  <view class="rental-due card" wx:if="{{isRental && rentalDue}}"><text class="rental-due-label">归还时点</text><text class="rental-due-value">{{rentalDue.dueAtText}}</text></view>
  <view class="empty card" wx:if="{{scooter.stockNote}}"><view class="muted">{{scooter.stockNote}}</view></view>
  <view class="address-head">
    <text class="address-title">常用地址</text>
    <text class="manage-address" bindtap="goAddresses">管理地址 ›</text>
  </view>
  <!-- ★ 失败占位（T49）：改造前失败会让「常用地址」卡片整块消失，
       用户会以为自己没存过地址。 -->
  <view wx:if="{{addressesError}}" class="load-error card">
    <view class="muted">{{addressesError}}</view>
    <button size="mini" class="ghost-button" bindtap="retryAddresses">重试</button>
  </view>
  <!-- ★ 空态用 `wx:elif="{{!addressesError}}"` 而不是 `wx:else`（T49 补修）。
       `wx:else` 的语义是「上一个 wx:if 为假」，而 `addresses.length === 0` 在**接口失败**
       时同样为假 —— 于是失败时页面会同时出现上面的「加载失败，请重试」和下面的
       「还没有常用地址」，同屏两句互相矛盾的话。改成 wx:elif 后，只有**确实没失败**
       时才敢说用户没存过地址。注释放在 wx:if 之前，避免插进 if/elif 链中间。 -->
  <view class="saved-addresses card" wx:if="{{addresses.length}}">
    <view class="saved-address {{selectedAddressId === item.id ? 'active' : ''}}" wx:for="{{addresses}}" wx:key="id" data-id="{{item.id}}" bindtap="selectAddress">
      <view class="saved-address-main">
        <view class="saved-address-name">{{item.contactName}} · {{item.contactPhone}}<text wx:if="{{item.isDefault}}" class="default-tag">默认</text></view>
        <view class="muted">{{item.address}}</view>
      </view>
      <button class="delete-address" size="mini" data-id="{{item.id}}" catchtap="deleteAddress">删除</button>
    </view>
  </view>
  <view class="empty card" wx:elif="{{!addressesError}}"><view class="muted">还没有常用地址，填写后可保存到本账号。</view></view>
  <view class="section-title">校内配送信息</view><view class="form card">
    <view class="field"><text class="field-label">联系人</text><input class="input" placeholder="请输入姓名" bindinput="setName" /></view>
    <view class="field"><text class="field-label">手机号</text><input class="input" type="number" maxlength="11" placeholder="用于确认库存" bindinput="setPhone" /></view>
    <view class="field"><text class="field-label">配送日期</text><picker mode="date" start="{{minDate}}" bindchange="setDate"><view class="input">{{date || '请选择日期'}}  ▾</view></picker></view>
    <view class="field"><text class="field-label">配送时段</text><picker range="{{deliveryTimeSlots}}" bindchange="setDeliveryTime"><view class="input">{{deliveryTimeSlots[deliveryTimeIndex] || '请选择时段'}}  ▾</view></picker></view>
    <view class="field"><text class="field-label">校内配送地址</text><input class="input" placeholder="例如：荟园学生社区附近" bindinput="setAddress" /></view>
    <view class="field"><text class="field-label">付款方式</text><view class="input fixed">在线支付</view></view>
  </view>
  <view class="address-save card" wx:if="{{!selectedAddressId}}">
    <view class="checkbox {{saveAddress ? 'checked' : ''}}" bindtap="setSaveAddress"><text wx:if="{{saveAddress}}">✓</text></view>
    <text>保存为我的常用地址，下次下单直接选择</text>
  </view>
  <view class="price-summary card" wx:if="{{!isRental}}"><view class="summary-row"><text>车辆费用</text><text>¥{{itemsFee}}</text></view><view class="summary-row"><text>校内配送</text><text>{{config.deliveryFeeText || '免费'}}</text></view><view class="summary-row total"><text>合计</text><text>¥{{totalFee}}</text></view><view class="summary-note">提交后 {{config.paymentTimeoutText || '30 分钟'}} 内完成支付；{{config.deliveryResponseHours || 24}}小时内响应，支付成功后进入待配送并同步免费校园牌照辅助。</view></view>
  <view class="price-summary card" wx:if="{{isRental && rentalFees}}">
    <view class="summary-row"><text>租金合计</text><text>{{rentalFees.rentText}}</text></view>
    <view class="summary-row"><text>押金</text><text>{{rentalFees.depositText}}</text></view>
    <view class="summary-row"><text>校内配送</text><text>{{rentalFees.deliveryFeeText}}</text></view>
    <view class="summary-row total"><text>应付合计</text><text>{{rentalFees.totalText}}</text></view>
    <view class="summary-note deposit-notice">{{rentalFees.depositNoticeText}}</view>
    <view class="summary-note">提交后 {{config.paymentTimeoutText || '30 分钟'}} 内完成支付；支付成功后进入待配送，归还核验通过后押金原路退回。</view>
  </view>
  <view class="agreement">{{isRental ? '支付成功后创建校内租赁订单，归还核验通过后押金原路退回。' : '支付成功后创建校内配送订单，并同步免费校园牌照辅助。'}}</view>
  <view class="agreement-row">
    <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgreement"><text wx:if="{{agreed}}">✓</text></view>
    <text>我已阅读并同意</text><text class="agreement-link" bindtap="openAgreement">《服务协议》</text><text>与</text><text class="agreement-link" bindtap="openPrivacy">《隐私政策》</text>
  </view>
  <button class="primary-button" disabled="{{!agreed || scooter.stockNote}}" bindtap="submit">提交并支付</button>
</view>
