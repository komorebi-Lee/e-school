<view wx:if="{{scooter}}" class="page">
  <view class="summary card"><view class="mark" style="background: {{scooter.color}}">{{scooter.icon}}</view><view><view class="name">{{scooter.name}}</view><view class="muted">{{scooter.subtitle}}</view><view class="price">¥{{scooter.price}}</view></view></view>
  <view class="section-title">校内配送信息</view><view class="form card">
    <view class="field"><text class="field-label">联系人</text><input class="input" placeholder="请输入姓名" bindinput="setName" /></view>
    <view class="field"><text class="field-label">手机号</text><input class="input" type="number" maxlength="11" placeholder="用于确认库存" bindinput="setPhone" /></view>
    <view class="field"><text class="field-label">配送日期</text><picker mode="date" bindchange="setDate"><view class="input">{{date || '请选择日期'}}  ▾</view></picker></view>
    <view class="field"><text class="field-label">校内配送地址</text><input class="input" placeholder="例如：荟园学生社区附近" bindinput="setAddress" /></view>
    <view class="field"><text class="field-label">付款方式</text><view class="input fixed">{{payment}}</view></view>
  </view>
  <view class="agreement">提交后客服将在24小时内联系，确认车型、报价与校内配送安排。</view><button class="primary-button" bindtap="submit">提交购车咨询</button>
</view>
