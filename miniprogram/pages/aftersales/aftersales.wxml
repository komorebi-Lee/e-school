<view class="page">
  <view wx:if="{{loading}}" class="notice">正在获取订单信息…</view>

  <view class="order-card card" wx:if="{{order}}">
    <view class="order-head"><text class="order-title">{{order.title}}</text><text class="order-status">{{order.statusLabel}}</text></view>
    <view class="order-meta"><text>编号 {{order.orderNo}}</text><text>{{order.merchantName}}</text></view>
    <view class="order-price">{{order.priceText}}</view>
  </view>
  <view wx:elif="{{!loading}}" class="notice">未找到可售后的电瓶车订单，请返回订单页重新进入。</view>

  <view class="promise card" wx:if="{{order && !existing}}">
    <view class="promise-row"><text class="promise-icon">响</text><view><view class="promise-title">{{afterSaleResponseHours}} 小时内响应</view><view class="muted">工作时段内优先处理校园车辆问题</view></view></view>
    <view class="promise-row"><text class="promise-icon">处</text><view><view class="promise-title">{{afterSaleResolutionHours}} 小时内给出处理结果</view><view class="muted">校内配送商品优先协调商家上门</view></view></view>
  </view>

  <view class="completed card" wx:if="{{completed}}">
    <view class="completed-title">最新售后结果</view>
    <view class="completed-copy muted">{{completed.typeLabel}} · {{completed.statusLabel}}</view>
    <view class="completed-copy muted" wx:if="{{completed.resolvedText}}">处理时间：{{completed.resolvedText}}</view>
    <view class="completed-copy muted" wx:if="{{completed.resolutionNote}}">处理结论：{{completed.resolutionNote}}</view>
    <view class="evidence-grid" wx:if="{{completed.images.length}}">
      <image wx:for="{{completed.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-urls="{{completed.images}}" data-url="{{item}}" bindtap="previewExistingImages" />
    </view>
    <button wx:if="{{order.canReview}}" size="mini" class="primary-button" bindtap="goReview">去评价本次服务</button>
  </view>

  <view class="platform-result card" wx:if="{{platformResult}}">
    <view class="platform-result-title">平台处理结果</view>
    <view class="platform-result-copy muted" wx:if="{{platformResult.resolvedText}}">处理时间：{{platformResult.resolvedText}}</view>
    <view class="platform-result-copy muted" wx:if="{{platformResult.note}}">处理结论：{{platformResult.note}}</view>
  </view>

  <view class="existing card" wx:if="{{existing}}">
    <view class="existing-title">{{existing.title}}</view>
    <view class="existing-copy muted">{{existing.typeLabel}} · {{existing.statusLabel}}</view>
    <view class="existing-copy muted">{{existing.tip}}</view>
    <view class="existing-copy muted" wx:if="{{existing.dueText}}">预计 {{existing.dueText}} 前响应</view>
    <view class="existing-copy muted" wx:if="{{existing.resolutionNote}}">处理结论：{{existing.resolutionNote}}</view>
    <view class="evidence-grid" wx:if="{{existing.images.length}}">
      <image wx:for="{{existing.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-urls="{{existing.images}}" data-url="{{item}}" bindtap="previewExistingImages" />
    </view>
    <button wx:if="{{existing.images.length < 9}}" size="mini" class="ghost-button" bindtap="chooseImage">补充问题图片</button>
    <view class="appeal-state" wx:if="{{appealRequested}}">已提交平台协助，等待平台处理</view>
    <view class="contact-row">
      <button size="mini" class="ghost-button" open-type="contact">微信客服</button>
      <button size="mini" class="ghost-button" bindtap="callContact">电话客服 {{contact}}</button>
    </view>
    <button size="mini" class="primary-button" wx:if="{{existing.statusLabel === '未通过' && !appealRequested}}" bindtap="requestAppeal" disabled="{{appealing}}">申请平台协助</button>
  </view>

  <block wx:if="{{order && !existing}}">
    <view class="section-title">需要什么帮助？</view>
    <view class="form card">
      <view class="field" wx:if="{{maxQuantity > 1}}">
        <text class="field-label">本次申请退款数量</text>
        <view class="quantity-row">
          <view class="quantity-control" data-action="decrease" bindtap="setQuantity">−</view>
          <view class="quantity-value">{{quantity}} 件 / 共 {{maxQuantity}} 件</view>
          <view class="quantity-control" data-action="increase" bindtap="setQuantity">＋</view>
        </view>
        <view class="muted">多辆车可只申请部分退款，剩余车辆继续正常履约。</view>
      </view>

      <view class="type-grid">
        <view class="type-item {{selectedType.key === item.key ? 'active' : ''}}" wx:for="{{typeOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseType">
          <view class="type-name">{{item.label}}</view>
          <view class="type-copy muted">{{item.copy}}</view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">常见原因</text>
        <view class="reason-grid">
          <view class="reason {{detail === item ? 'active' : ''}}" wx:for="{{selectedType.reasons}}" wx:key="*this" data-reason="{{item}}" bindtap="chooseReason">{{item}}</view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">补充说明</text>
        <textarea class="input textarea" placeholder="可补充时间、地点、车辆问题或期望处理方式" bindinput="setDetail"></textarea>
      </view>

      <view class="field">
        <text class="field-label">问题图片（选填）</text>
        <view class="evidence-grid">
          <view class="evidence-item" wx:for="{{images}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewNewImages" />
            <text class="evidence-remove" data-index="{{index}}" bindtap="removeImage">×</text>
          </view>
          <view wx:if="{{images.length < 3}}" class="evidence-add" bindtap="chooseImage">＋</view>
        </view>
        <view class="muted">建议上传车辆问题、外包装或异常部位照片，最多 3 张。</view>
      </view>

      <button class="primary-button" bindtap="submit" disabled="{{submitting}}">{{submitting ? '正在提交…' : '提交售后申请'}}</button>
      <view class="privacy muted">提交后商家和平台都能看到处理进度，避免重复沟通。</view>
    </view>
  </block>
</view>
