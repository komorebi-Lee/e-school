<view class="page post-page">
  <!-- 失败占位：接口挂了必须说出来，并且能重试。旧数据（若有）仍显示在下方。 -->
  <view wx:if="{{postError}}" class="load-error card">
    <view class="muted">{{postError}}</view>
    <button size="mini" class="ghost-button" bindtap="retryPost">重试</button>
  </view>
  <view wx:if="{{loading}}" class="empty card"><view class="muted">正在加载帖子…</view></view>
  <!-- ★ 只有**确定是 404** 才落这句。网络失败走上面的错误占位 ——
       改造前判的是 `!post`，于是作者本人会以为自己的帖子被删或被隐藏了。 -->
  <view wx:elif="{{postNotFound}}" class="empty card">
    <view class="empty-title">帖子不存在或已隐藏</view>
    <button size="mini" class="primary-button" bindtap="goForum">回论坛</button>
  </view>
  <block wx:if="{{post}}">
    <view class="main card">
      <view class="post-head">
        <text class="board-tag">{{post.boardText}}</text>
        <text class="muted small">{{post.authorName}} · {{post.createdAt}}</text>
      </view>
      <view class="title">{{post.title}}</view>
      <view class="content">{{post.content}}</view>
      <view class="images" wx:if="{{post.images.length}}">
        <image wx:for="{{post.images}}" wx:key="*this" class="post-image" src="{{item}}" mode="aspectFill" data-urls="{{post.images}}" data-url="{{item}}" bindtap="previewImages" />
      </view>
      <view class="actions">
        <button size="mini" class="ghost-button {{post.liked ? 'liked' : ''}}" bindtap="toggleLike">{{post.liked ? '♥' : '♡'}} {{post.likes}}</button>
        <text class="muted small">💬 {{post.commentCount}} 条评论</text>
        <!-- 作者自管理（M7-P1-01）：只有作者看得到这两个操作。 -->
        <button
          wx:if="{{post.isOwner}}"
          size="mini"
          class="ghost-button"
          bindtap="toggleVisibility"
          disabled="{{togglingStatus}}"
        >{{post.status === 'HIDDEN' ? '恢复帖子' : '隐藏帖子'}}</button>
      </view>
      <!-- 作者本人打开自己的隐藏帖时（服务端对作者放行）明确告知当前状态，
           否则他会以为帖子还在正常展示。 -->
      <view wx:if="{{post.isOwner && post.status === 'HIDDEN'}}" class="muted small">该帖子已隐藏，只有你自己能看到。</view>
    </view>

    <view class="section-title">评论</view>
    <view class="comments">
      <view class="comment card" wx:for="{{post.comments}}" wx:key="id">
        <view class="comment-head"><text class="comment-author">{{item.authorName}}</text><text class="muted small">{{item.createdAt}}</text></view>
        <view class="comment-content">{{item.content}}</view>
      </view>
      <!-- ★ 「还没有评论」是**关于帖子的一个事实断言**，接口失败时不许说（T49 补修）。
         首屏失败时 `post` 为 null，外层 `<block wx:if="{{post}}">` 已经挡住了；
         但**刷新失败**时 `post` 与 `post.comments` 都是上一份缓存，若缓存里评论为空，
         就会出现「加载失败，请重试」+「还没有评论」同屏。`!postError` 挡住这一路。 -->
    <view wx:if="{{!postError && !post.comments.length}}" class="empty card"><view class="muted">还没有评论，来抢沙发。</view></view>
    </view>

    <view class="safe-space"></view>
    <view class="comment-bar">
      <input class="comment-input" placeholder="友善评论…" value="{{comment}}" bindinput="setComment" confirm-type="send" bindconfirm="submitComment" maxlength="300" />
      <button size="mini" class="primary-button" bindtap="submitComment" disabled="{{submitting}}">发送</button>
    </view>
  </block>
</view>
