<view class="page">
  <view wx:if="{{loading}}" class="empty card"><view class="muted">正在加载评价…</view></view>
  <view wx:elif="{{!reviews.length}}" class="empty card"><view class="muted">暂无评价，完成订单后可对商品进行评价</view></view>
  <block wx:else>
    <view class="summary card">共 {{reviews.length}} 条评价</view>
    <view id="my-review-{{item.id}}" class="review card" wx:for="{{reviews}}" wx:key="id">
      <view class="head">
        <view>
          <view class="product" bindtap="goDetail" data-id="{{item.productId}}">{{item.productName}} ›</view>
          <view class="muted">{{item.dateText}}</view>
        </view>
        <text class="stars">{{item.stars}}</text>
      </view>
      <view class="content">{{item.content}}</view>
      <view class="images" wx:if="{{item.images.length}}">
        <image wx:for="{{item.images}}" wx:for-item="image" wx:key="*this" src="{{image}}" mode="aspectFill" />
      </view>
      <view class="hidden-tag" wx:if="{{item.hidden}}">该评价已被平台隐藏</view>
      <view class="reply" wx:if="{{item.reply}}">
        <view class="reply-title">{{item.reply.merchantName}}</view>
        <view class="reply-content">{{item.reply.content}}</view>
      </view>
    </view>
  </block>
</view>
