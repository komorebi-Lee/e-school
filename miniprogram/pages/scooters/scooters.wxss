.policy { display: flex; align-items: center; padding: 24rpx; }.policy-mark { width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 20rpx; background: #d9f7ea; color: #157552; font-weight: 900; font-size: 34rpx; margin-right: 20rpx; }.policy-title { font-weight: 800; margin-bottom: 6rpx; }
.product { margin-bottom: 22rpx; overflow: hidden; }.visual { height: 220rpx; display: flex; align-items: center; justify-content: center; font-size: 76rpx; color: #1746a2; font-weight: 900; position: relative; }.badge { position: absolute; top: 18rpx; left: 18rpx; background: rgba(255,255,255,.82); color: #172033; }.body { padding: 24rpx; }.name { font-size: 32rpx; font-weight: 900; }.subtitle { margin: 8rpx 0 20rpx; }.specs,.bottom { display: flex; justify-content: space-between; }.specs { background: #f5f7fb; padding: 16rpx; border-radius: 14rpx; font-size: 23rpx; color: #536078; }.bottom { margin-top: 22rpx; align-items: center; }.stock { color: #78849a; font-size: 22rpx; }.price { font-size: 34rpx; }
