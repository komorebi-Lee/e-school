<view class="page">
  <view class="policy card"><view class="policy-mark">校</view><view><view class="policy-title">华农校园通勤车型</view><view class="muted">车型评价均来自平台核验的已购学生</view></view></view>
  <view class="section-title">购买电瓶车</view>
  <view class="toolbar card">
    <input class="input search" placeholder="搜索车型或需求" value="{{query}}" bindinput="setSearch" />
    <scroll-view class="sort-tabs" scroll-x show-scrollbar="{{false}}">
      <view class="sort-inner">
        <view wx:for="{{sortOptions}}" wx:key="key" class="sort-tab {{sortKey === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="setSort">{{item.label}}</view>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{!loading && !filtered.length}}" class="empty card">
    <view class="empty-title">没有匹配的车型</view>
    <view class="muted">看看热销车型，换个通勤思路</view>
    <view class="hot-list">
      <view wx:for="{{hotProducts}}" wx:key="id" class="hot-card" data-id="{{item.id}}" bindtap="goDetail">
        <view class="hot-name">{{item.name}}</view>
        <view class="hot-meta"><text>¥{{item.price}}</text><text>{{item.salesText}}</text></view>
      </view>
    </view>
  </view>
  <view wx:for="{{filtered}}" wx:key="id" class="product card" data-id="{{item.id}}" bindtap="goDetail">
    <view class="visual" style="background: {{item.color}}"><image wx:if="{{item.imageUrl}}" class="product-image" src="{{item.imageUrl}}" mode="aspectFit" /><text wx:else>{{item.icon}}</text><view class="pill badge">{{item.badge}}</view></view>
    <view class="body">
      <view class="name">{{item.name}}</view>
      <view class="muted subtitle">{{item.subtitle}}</view>
      <view class="rating">
        <text class="rating-score" wx:if="{{item.ratingText}}">{{item.ratingText}}</text>
        <text class="rating-score" wx:else>新品</text>
        <text class="muted">{{item.ratingCountText}}</text>
        <text class="sales">{{item.salesText}}</text>
      </view>
      <view class="specs"><text>续航 {{item.range}}</text><text>限速 {{item.speed}}</text></view>
      <view class="tags"><text>校内配送</text><text>牌照辅助</text></view>
      <view class="bottom">
        <text class="stock {{item.urgent ? 'urgent' : ''}}">{{item.stockText}}</text>
        <text class="price">¥{{item.price}}</text>
      </view>
    </view>
  </view>
</view>
