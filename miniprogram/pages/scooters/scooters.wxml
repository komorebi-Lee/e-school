<view class="page">
  <view class="policy card"><view class="policy-mark">校</view><view><view class="policy-title">华农校园通勤车型</view><view class="muted">正式运营前仍需以学校最新车辆规定复核</view></view></view>
  <view class="section-title">购买电瓶车</view>
  <view wx:for="{{scooters}}" wx:key="id" class="product card" data-id="{{item.id}}" bindtap="goDetail">
    <view class="visual" style="background: {{item.color}}"><text>{{item.icon}}</text><view class="pill badge">{{item.badge}}</view></view>
    <view class="body"><view class="name">{{item.name}}</view><view class="muted subtitle">{{item.subtitle}}</view><view class="specs"><text>续航 {{item.range}}</text><text>限速 {{item.speed}}</text></view><view class="bottom"><text class="stock">库存 {{item.stock}}</text><text class="price">¥{{item.price}}</text></view></view>
  </view>
</view>
