.search-page { padding: 28rpx; }
.search-bar { padding: 18rpx; margin-bottom: 20rpx; }
.search-input { background: #f5f7fb; border-radius: 18rpx; padding: 22rpx; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.tab { padding: 10rpx 20rpx; border-radius: 999rpx; background: #f5f7fb; color: #536078; font-size: 22rpx; font-weight: 700; }
.tab.active { background: #002fa7; color: #fff; }
.result { display: flex; align-items: center; gap: 20rpx; padding: 20rpx; margin-bottom: 18rpx; }
.result-thumb { width: 128rpx; height: 128rpx; border-radius: 20rpx; background: #f5f7fb; object-fit: cover; }
.result-main { min-width: 0; flex: 1; }
.result-title { font-size: 28rpx; font-weight: 900; color: #17233d; }
.result-desc { margin-top: 8rpx; font-size: 21rpx; line-height: 1.45; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.result-meta { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 12rpx; color: #78849a; font-size: 20rpx; }
.price-group { display: flex; align-items: baseline; gap: 10rpx; flex-shrink: 0; }
.original-price { color: #98a4b7; font-size: 22rpx; text-decoration: line-through; }
.price { color: #002fa7; font-size: 30rpx; font-weight: 900; }
.empty { margin-top: 30rpx; padding: 70rpx 30rpx; text-align: center; }
.empty-title { font-size: 30rpx; font-weight: 900; color: #17233d; margin-bottom: 8rpx; }
