<view class="page search-page">
  <view class="search-bar card">
    <input
      class="search-input"
      placeholder="搜索电瓶车、电话卡、套餐"
      confirm-type="search"
      value="{{query}}"
      bindinput="setKeyword"
      bindconfirm="confirmSearch"
    />
  </view>
  <view class="suggest card" wx:if="{{!query && (searchHistory.length || hotKeywords.length)}}">
    <view class="suggest-row" wx:if="{{searchHistory.length}}">
      <view class="suggest-head">
        <text class="suggest-title">搜索历史</text>
        <text class="suggest-clear" bindtap="clearHistory">清空</text>
      </view>
      <view class="suggest-tags">
        <view class="suggest-tag" wx:for="{{searchHistory}}" wx:key="*this" data-keyword="{{item}}" bindtap="tapKeyword">{{item}}</view>
      </view>
    </view>
    <view class="suggest-row" wx:if="{{hotKeywords.length}}">
      <view class="suggest-head"><text class="suggest-title">热门搜索</text></view>
      <view class="suggest-tags">
        <view class="suggest-tag hot" wx:for="{{hotKeywords}}" wx:key="*this" data-keyword="{{item}}" bindtap="tapKeyword">{{item}}</view>
      </view>
    </view>
  </view>
  <view class="tabs">
    <view class="tab {{activeTab === 'ALL' ? 'active' : ''}}" data-tab="ALL" bindtap="setTab">全部</view>
    <view class="tab {{activeTab === 'E_BIKE_NEW' ? 'active' : ''}}" data-tab="E_BIKE_NEW" bindtap="setTab">电瓶车</view>
    <view class="tab {{activeTab === 'PHONE_PLAN' ? 'active' : ''}}" data-tab="PHONE_PLAN" bindtap="setTab">电话卡</view>
    <view class="tab {{activeTab === 'PROMO' ? 'active' : ''}}" data-tab="PROMO" bindtap="setTab">限时权益</view>
  </view>
  <!-- 失败占位：接口挂了必须说出来，并且能重试。上一次的结果（若有）仍显示在下方。 -->
  <view wx:if="{{resultsError}}" class="load-error card">
    <view class="muted">{{resultsError}}</view>
    <button size="mini" class="ghost-button" bindtap="retryResults">重试</button>
  </view>
  <view wx:if="{{loading}}" class="empty card">
    <view class="empty-title">正在搜索…</view>
    <view class="muted">稍等一下，马上给你结果。</view>
  </view>
  <block wx:else>
    <view class="result-summary" wx:if="{{filteredProducts.length || filteredPromos.length}}">
      <text>{{filteredProducts.length + filteredPromos.length}} 条结果</text>
      <text class="clear-filter" wx:if="{{query || activeTab !== 'ALL'}}" bindtap="resetFilters">清空筛选</text>
    </view>
    <view
      class="result card"
      wx:for="{{filteredProducts}}"
      wx:key="id"
      data-kind="product"
      data-id="{{item.id}}"
      data-category="{{item.category}}"
      bindtap="goItem"
    >
      <image class="result-thumb" src="{{item.imageUrl}}" mode="aspectFill" wx:if="{{item.imageUrl}}" />
      <view class="result-main">
        <view class="result-title">{{item.name}}</view>
        <view class="muted result-desc">{{item.description}}</view>
        <view class="result-meta">
          <text>{{item.typeText}}</text>
          <text>{{item.stockText}}</text>
          <text class="service-score" wx:if="{{item.merchantScore}}">{{item.serviceScoreText}}</text>
        </view>
      </view>
      <view class="price-group">
        <text wx:if="{{item.originalPrice}}" class="original-price">¥{{item.originalPrice}}</text>
        <view class="price">¥{{item.price}}</view>
      </view>
    </view>
    <view
      class="result card"
      wx:for="{{filteredPromos}}"
      wx:key="id"
      data-kind="promo"
      data-id="{{item.id}}"
      bindtap="goItem"
    >
      <view class="result-main">
        <view class="result-title">{{item.title}}</view>
        <view class="muted result-desc">{{item.description}}</view>
        <view class="result-meta">
          <text>{{item.badge}}</text>
          <text>限时权益</text>
        </view>
      </view>
      <view class="price-group">
        <view class="price">¥{{item.pay}}</view>
      </view>
    </view>
    <!-- ★ 失败时不得落这句：「没有匹配的结果 / 换个关键词」是关于**搜索结果**的事实陈述，
         而失败时我们并不知道有没有匹配。改造前判的是 `!filteredProducts.length && !filteredPromos.length`，
         任何失败都会渲染它，用户会一直换关键词试一个永远搜不出来的东西。 -->
    <view wx:if="{{!filteredProducts.length && !filteredPromos.length && !resultsError}}" class="empty card">
      <view class="empty-title">没有匹配的结果</view>
      <view class="muted">换个关键词，或看看首页推荐。</view>
      <view class="empty-actions">
        <button size="mini" class="ghost-button" bindtap="resetFilters">清空筛选</button>
        <button size="mini" class="primary-button" bindtap="goHome">去逛首页</button>
      </view>
    </view>
  </block>
</view>
