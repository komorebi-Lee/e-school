<view class="page addresses-page">
  <view class="header card">
    <view>
      <view class="title">常用地址</view>
      <view class="muted">保存后下单更快，也可以在这里管理默认地址。</view>
    </view>
    <button size="mini" class="ghost-button" bindtap="{{form.visible ? 'cancelForm' : 'startCreate'}}">
      {{form.visible ? '收起' : '新增地址'}}
    </button>
  </view>
  <view class="form card" wx:if="{{form.visible}}">
    <view class="form-title">{{form.id ? '编辑地址' : '新增地址'}}</view>
    <view class="field">
      <text class="field-label">联系人</text>
      <input class="input" value="{{form.contactName}}" data-key="contactName" bindinput="setField" placeholder="请输入姓名" />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{form.contactPhone}}" data-key="contactPhone" bindinput="setField" placeholder="请输入手机号" />
    </view>
    <view class="field">
      <text class="field-label">校内地址</text>
      <input class="input" value="{{form.address}}" data-key="address" bindinput="setField" placeholder="例如：荟园学生社区附近" />
    </view>
    <view class="field">
      <text class="field-label">校区</text>
      <input class="input" value="{{form.campusName}}" data-key="campusName" bindinput="setField" placeholder="例如：狮山校区" />
    </view>
    <view class="form-actions">
      <button class="ghost-button" bindtap="cancelForm">取消</button>
      <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveAddress">保存</button>
    </view>
  </view>
  <view class="address-item card" wx:for="{{addresses}}" wx:key="id">
    <view class="item-main">
      <view class="item-head">
        <strong>{{item.contactName}}</strong>
        <text class="phone">{{item.contactPhone}}</text>
        <text wx:if="{{item.isDefault}}" class="default-tag">默认</text>
      </view>
      <view class="muted address">{{item.address}}</view>
      <view class="muted small" wx:if="{{item.campusName}}">{{item.campusName}}</view>
    </view>
    <view class="item-actions">
      <button size="mini" class="ghost-button" data-id="{{item.id}}" disabled="{{item.isDefault}}" bindtap="setDefault">
        {{item.isDefault ? '默认地址' : '设为默认'}}
      </button>
      <button size="mini" class="ghost-button" data-id="{{item.id}}" bindtap="startEdit">编辑</button>
      <button size="mini" class="danger-button" data-id="{{item.id}}" bindtap="deleteAddress">删除</button>
    </view>
  </view>
  <view class="empty card" wx:if="{{!loading && !addresses.length}}">
    <view class="empty-title">还没有常用地址</view>
    <view class="muted">新增一个，下次校内配送直接选择。</view>
  </view>
</view>
