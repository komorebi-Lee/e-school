.addresses-page { padding: 28rpx; }
.header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; }
.header .title { font-size: 34rpx; font-weight: 900; color: #17233d; }
.header .muted { margin-top: 8rpx; font-size: 21rpx; }
.form { margin-top: 20rpx; padding: 24rpx; }
.form-title { font-size: 28rpx; font-weight: 900; margin-bottom: 20rpx; }
.form-actions { display: flex; justify-content: flex-end; gap: 18rpx; margin-top: 24rpx; }
.address-item { margin-top: 20rpx; padding: 22rpx; }
.item-head { display: flex; align-items: center; gap: 12rpx; font-size: 26rpx; font-weight: 900; }
.item-head .phone { color: #78849a; font-weight: 700; }
.default-tag { display: inline-flex; padding: 4rpx 10rpx; border-radius: 999rpx; background: #eaf0ff; color: #002fa7; font-size: 19rpx; font-weight: 900; }
.address { margin-top: 10rpx; font-size: 22rpx; line-height: 1.45; }
.item-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 18rpx; }
.danger-button { background: #fff1f1; color: #c94831; font-weight: 800; }
.empty { margin-top: 30rpx; padding: 70rpx 30rpx; text-align: center; }
.empty-title { font-size: 30rpx; font-weight: 900; margin-bottom: 8rpx; }
